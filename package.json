{
  "name": "pagehaven",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "init": "node scripts/init-site.mjs",
    "customize": "node scripts/customize.mjs",
    "ingest:labelplus": "node scripts/ingest-labelplus.mjs",
    "ingest:ocr": "node scripts/ingest-ocr.mjs",
    "build:config": "node scripts/build-config.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "verify:manifest": "node scripts/build-manifest.mjs --verify-only",
    "build:db": "node scripts/build-db.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:index": "node scripts/build-index.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build": "pnpm run build:config && pnpm run build:manifest && pnpm run build:db && pnpm run build:site && pnpm run build:index && pnpm run build:sitemap",
    "check": "node scripts/check.mjs",
    "check:data": "node scripts/check-data.mjs",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "test:docs": "node --test scripts/test/docs-site.test.mjs",
    "publish:r2": "node scripts/publish-r2.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:activate": "node scripts/release.mjs activate",
    "deploy:cloudflare": "node scripts/deploy.mjs cloudflare",
    "deploy:workers": "node scripts/deploy.mjs workers",
    "deploy:esa": "node scripts/deploy.mjs esa",
    "deploy:edgeone": "node scripts/deploy.mjs edgeone",
    "deploy:github": "node scripts/deploy.mjs github",
    "purge": "node scripts/purge.mjs",
    "push:search": "node scripts/seo-push.mjs",
    "status": "node scripts/write-status.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "js-yaml": "^4.1.0",
    "undici": "8.12.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "eslint": {
      "minimatch": "11.0.1",
      "@eslint/config-array": {
        "minimatch": "11.0.1"
      }
    }
  },
  "packageManager": "pnpm@12.6.0"
}
