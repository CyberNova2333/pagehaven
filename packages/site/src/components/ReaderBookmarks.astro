<div id="reader-bookmarks" class="reader-bookmarks" hidden>
  <div class="bookmark-actions">
    <span data-bookmark-page></span>
    <button class="btn" type="button" data-bookmark-toggle aria-pressed="false">收藏当前页</button>
    <button class="btn" type="button" data-bookmark-edit>添加备注</button>
    <a href="/library/#library-bookmarks">查看全部书签</a>
  </div>
  <p data-bookmark-current-note class="bookmark-note" hidden></p>
  <div class="bookmark-editor" data-bookmark-editor hidden>
    <label for="reader-bookmark-note"><strong data-bookmark-editing-page></strong> · 备注（最多 200 字符）</label>
    <textarea id="reader-bookmark-note" data-bookmark-note maxlength="200" rows="3" placeholder="记下喜欢的画面或想回看的内容"></textarea>
    <div class="bookmark-actions">
      <button class="btn btn-primary" type="button" data-bookmark-save>保存书签和备注</button>
      <button class="btn" type="button" data-bookmark-cancel>取消</button>
    </div>
    <p class="muted">翻页不会改变正在编辑的书签页码；保存后可在书架查看。</p>
  </div>
  <p data-bookmark-message class="muted" role="status" aria-live="polite"></p>
</div>

<script>
  import { mountReaderBookmarks } from '../lib/reader-bookmarks.js';
  const reader = document.getElementById('reader');
  const root = document.getElementById('reader-bookmarks');
  if (reader && root) mountReaderBookmarks(reader, root);
</script>

<style is:global>
  .reader-bookmarks { padding: 14px 16px; margin: 8px 0 16px; border: 1px solid var(--border-default); border-radius: 6px; background: var(--canvas-subtle); color: var(--fg-default); }
  .reader-bookmarks[hidden], .reader-bookmarks [hidden] { display: none; }
  .bookmark-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .reader-bookmarks .btn { padding: 4px 12px; font-size: 13px; }
  .reader-bookmarks a, .reader-bookmarks p { font-size: 13px; }
  .reader-bookmarks p { margin: 8px 0 0; }
  .reader-bookmarks p:empty { display: none; }
  .bookmark-note { white-space: pre-wrap; overflow-wrap: anywhere; }
  .bookmark-editor { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border-muted); }
  .bookmark-editor label { display: block; font-size: 13px; font-weight: 600; }
  .bookmark-editor textarea { display: block; box-sizing: border-box; width: 100%; resize: vertical; padding: 8px 12px; margin: 6px 0; font: 13px/1.5 var(--font-sans); color: var(--fg-default); background: var(--canvas-default); border: 1px solid var(--border-default); border-radius: 6px; }
  .reader.mode-double .reader-bookmarks { grid-column: 1 / -1; }
</style>
