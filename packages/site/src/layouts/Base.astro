---
// 所有页面共用的外壳：lang / title / viewport / canonical / og:title、站点外观、内联样式、
// 导航与页脚。不用 UI 框架——站点要在三平台的纯静态基线上跑（铁律 2），每话一个 HTML 又
// 有 18 000 份的量级（ARCHITECTURE §2），外壳越薄越好；样式随 inlineStylesheets=always 内联，
// dist 里不多出一个文件。
//
// 语义色与标题字体来自唯一配置源，默认使用 Enterprise 品牌蓝与中性表面。
// 字体随静态产物提供，不依赖外部字体服务。
//
// props：
//   title    页面标题（不含站名；空则只用站名）
//   url      站内路径（以 / 开头、/ 结尾），拼 canonical 与 og:url 用；域名来自 site.config.yaml
//   crumbs   面包屑 [{ text, href? }]，首页那一级由外壳自己加
//   noindex  真则不出 canonical、加 robots noindex（404 页用）
import siteConfig from '../generated/site-config.json';
import { appearanceVariables } from '../lib/site-appearance.js';
import { initializeColorScheme } from '../lib/color-scheme.js';

const { site } = siteConfig;
const appearance = siteConfig.appearance ?? {};
const variables = appearanceVariables(appearance);
const darkVariables = appearanceVariables(appearance, 'dark');
const declarations = (values) => Object.entries(values).map(([key, value]) => `${key}:${value};`).join('');
const lightCSS = declarations(variables);
const darkCSS = declarations(darkVariables);
const paletteCSS = `:root{${lightCSS}}@media(prefers-color-scheme:dark){:root:not([data-color-scheme="light"]){${darkCSS}}}:root[data-color-scheme="dark"]{${darkCSS}}`;
const colorSchemeScript = `(${initializeColorScheme.toString()})(window,document);`;
const logo = site.logo ?? '/favicon.svg';
const tagline = site.tagline ?? '在页间，遇见好故事';
const showSearch = appearance.show_search !== false;
const showLibrary = appearance.show_library !== false;
const { title = '', url = '/', crumbs = [], description = tagline } = Astro.props;
const noindex = Boolean(Astro.props.noindex || siteConfig.preview);
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = `https://${site.domain}${url}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={variables['--bg-mid']} media="(prefers-color-scheme: light)" data-color-scheme-meta="light" />
    <meta name="theme-color" content={darkVariables['--bg-mid']} media="(prefers-color-scheme: dark)" data-color-scheme-meta="dark" />
    <style id="site-color-palettes" is:inline set:html={paletteCSS} />
    <script id="color-scheme-bootstrap" is:inline set:html={colorSchemeScript} />
    <link rel="icon" href={logo} />
    <title>{fullTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {description && <meta name="description" content={description} />}
    <slot name="head" />
    <script>import { mountPageMotion } from '../lib/page-motion.js'; mountPageMotion();</script>
    <style is:global>
      @font-face { font-family: 'IBM Plex Sans'; src: url('/fonts/ibm-plex-sans-latin-400.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'IBM Plex Sans'; src: url('/fonts/ibm-plex-sans-latin-700.woff2') format('woff2'); font-weight: 700; font-display: swap; }
      :root {
        color-scheme: var(--color-scheme);
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', 'IBM Plex Sans', 'Microsoft YaHei', system-ui, sans-serif;
        --font-serif: 'Noto Serif SC', 'Songti SC', Georgia, serif;
        --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
        --canvas-default: #ffffff;
        --canvas-subtle: #f6f8fa;
        --canvas-inset: #f6f8fa;
        --canvas-muted: #eaeef2;
        --fg-default: #1f2328;
        --fg-muted: #57606a;
        --fg-subtle: #6e7781;
        --fg-on-emphasis: #ffffff;
        --border-default: #d0d7de;
        --border-muted: #d8dee4;
        --accent-fg: #0969da;
        --accent-emphasis: #0969da;
        --accent-hover: #0860ca;
        --accent-subtle: #ddf4ff;
        --accent-muted: rgba(84, 174, 255, 0.4);
        --attention-fg: #9a6700;
        --attention-subtle: #fff8c5;
        --attention-muted: rgba(212, 167, 44, 0.4);
        --btn-shadow: 0 1px 0 rgba(31, 35, 40, 0.04);
        --radius: 6px;
        --bg-top: var(--canvas-default);
        --bg-mid: var(--canvas-default);
        --bg-low: var(--canvas-subtle);
        --bg: var(--canvas-default);
        --surface: var(--canvas-default);
        --surface-soft: var(--canvas-subtle);
        --surface-raised: var(--canvas-default);
        --ink: var(--fg-default);
        --fg: var(--fg-default);
        --text: var(--fg-default);
        --text-dim: var(--fg-muted);
        --muted: var(--fg-muted);
        --line: var(--border-default);
        --accent: var(--accent-emphasis);
        --accent-strong: var(--accent-fg);
        --accent-alt: var(--accent-fg);
        --accent-soft: var(--accent-subtle);
        --on-accent: var(--fg-on-emphasis);
        --link: var(--accent-fg);
        --focus-ring: var(--accent-subtle);
        --selection: var(--accent-subtle);
        --highlight: var(--attention-fg);
        --reader-bg: #010409;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-color-scheme="light"]) {
          --canvas-default: #0d1117;
          --canvas-subtle: #161b22;
          --canvas-inset: #010409;
          --canvas-muted: #21262d;
          --fg-default: #f0f6fc;
          --fg-muted: #8b949e;
          --fg-subtle: #6e7681;
          --fg-on-emphasis: #ffffff;
          --border-default: #30363d;
          --border-muted: #21262d;
          --accent-fg: #2f81f7;
          --accent-emphasis: #1f6feb;
          --accent-hover: #388bfd;
          --accent-subtle: rgba(56, 139, 253, 0.15);
          --accent-muted: rgba(56, 139, 253, 0.4);
          --attention-fg: #d29922;
          --attention-subtle: rgba(187, 128, 9, 0.15);
          --attention-muted: rgba(187, 128, 9, 0.4);
          --btn-shadow: 0 0 transparent;
        }
      }
      :root[data-color-scheme="dark"] {
        --canvas-default: #0d1117;
        --canvas-subtle: #161b22;
        --canvas-inset: #010409;
        --canvas-muted: #21262d;
        --fg-default: #f0f6fc;
        --fg-muted: #8b949e;
        --fg-subtle: #6e7681;
        --fg-on-emphasis: #ffffff;
        --border-default: #30363d;
        --border-muted: #21262d;
        --accent-fg: #2f81f7;
        --accent-emphasis: #1f6feb;
        --accent-hover: #388bfd;
        --accent-subtle: rgba(56, 139, 253, 0.15);
        --accent-muted: rgba(56, 139, 253, 0.4);
        --attention-fg: #d29922;
        --attention-subtle: rgba(187, 128, 9, 0.15);
        --attention-muted: rgba(187, 128, 9, 0.4);
        --btn-shadow: 0 0 transparent;
      }
      * { box-sizing: border-box; }
      ::selection { background: var(--selection); color: var(--ink); }
      :focus-visible { outline: 2px solid var(--accent-fg); outline-offset: 2px; }
      input, select, button { accent-color: var(--accent); font: inherit; }
      html {
        background: var(--canvas-default);
        scrollbar-gutter: stable;
        overflow-y: scroll;
      }
      body { margin: 0; min-height: 100vh; color: var(--fg-default); font: 14px/1.5 var(--font-sans); background: var(--canvas-default); -webkit-font-smoothing: antialiased; }
      a { color: var(--accent-fg); text-decoration: none; transition: color 120ms ease; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1, h2, h3 { color: var(--fg-default); font-family: var(--font-sans); font-weight: 600; letter-spacing: -.01em; }
      h1 { font-size: 24px; line-height: 1.25; margin: 4px 0 12px; }
      h2 { font-size: 16px; line-height: 1.4; margin: 28px 0 12px; }
      h3 { font-size: 14px; line-height: 1.4; }
      .topbar, main, footer { max-width: 72rem; margin: 0 auto; padding-inline: 24px; }
      .topbar { position: sticky; top: 0; z-index: 20; max-width: none; min-height: 56px; padding-block: 10px; background: var(--canvas-subtle); border-bottom: 1px solid var(--border-default); box-shadow: 0 1px 2px rgba(31, 35, 40, 0.04); }
      .topbar nav { display: flex; align-items: center; flex-wrap: nowrap; gap: 12px; max-width: 72rem; min-height: 36px; margin: auto; font-size: 14px; }
      .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--fg-default); font: 600 16px/1.25 var(--font-sans); }
      .brand:hover { text-decoration: none; color: var(--accent-fg); }
      .brand .mark { width: 24px; height: 24px; border-radius: 6px; flex: none; object-fit: contain; }
      .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--fg-muted); min-width: 0; font-size: 13px; }
      .crumbs a { color: var(--fg-muted); } .crumbs a:hover { color: var(--accent-fg); } .crumbs span[aria-hidden] { margin: 0 2px; color: var(--fg-subtle); }
      .topbar .spacer { flex: 1; } .nav-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-left: auto; }
      .color-scheme-control { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .color-scheme-control:not([hidden]) { display: inline-flex; }
      .color-scheme-control select { max-width: 8rem; min-height: 32px; padding: 4px 10px; border: 1px solid var(--border-default); border-radius: 6px; background: var(--canvas-default); color: var(--fg-default); font: 12px/1.4 var(--font-sans); }
      #color-scheme-status { width: 100%; max-width: 72rem; margin: 6px auto 0; color: var(--fg-muted); font-size: 12px; }
      .pill { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 5px 12px; border: 1px solid var(--border-default); border-radius: 6px; background: linear-gradient(180deg, var(--canvas-default) 0%, var(--canvas-subtle) 100%); color: var(--fg-default); font-size: 13px; font-weight: 500; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 1px 2px rgba(31, 35, 40, 0.05); transition: border-color 120ms ease, background 120ms ease, color 120ms ease, transform 80ms ease; }
      .pill:hover { background: var(--canvas-subtle); border-color: var(--border-default); text-decoration: none; transform: translateY(-0.5px); }
      .pill:active { transform: translateY(0.5px) scale(0.99); box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.12); }
      .pill[aria-current="page"] { background: var(--accent-subtle); border-color: var(--accent-muted); color: var(--accent-fg); font-weight: 600; text-decoration: none; }
      main { padding-block: 24px 48px; } .muted, .lede { color: var(--fg-muted); } .lede { max-width: 48rem; line-height: 1.6; }
      .eyebrow { margin: 0 0 4px; color: var(--fg-muted); font: 600 12px/1.4 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
      .card { background: var(--canvas-default); border: 1px solid var(--border-default); border-radius: 8px; box-shadow: 0 1px 3px rgba(31, 35, 40, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.6); }
      .card-pad { padding: 20px; }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 32px; padding: 5px 16px; border-radius: 6px; border: 1px solid var(--border-default); background: linear-gradient(180deg, var(--canvas-default) 0%, var(--canvas-subtle) 100%); color: var(--fg-default); font: 500 14px/20px var(--font-sans); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 1px 2px rgba(31, 35, 40, 0.06); cursor: pointer; transition: border-color 120ms ease, background 120ms ease, color 120ms ease, transform 80ms ease, box-shadow 80ms ease; }
      .btn:hover:not(:disabled) { background: linear-gradient(180deg, var(--canvas-subtle) 0%, color-mix(in srgb, var(--canvas-subtle) 85%, var(--fg-muted) 15%) 100%); border-color: color-mix(in srgb, var(--border-default) 60%, var(--fg-muted)); text-decoration: none; transform: translateY(-0.5px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 2px 5px rgba(31, 35, 40, 0.1); }
      .btn:active:not(:disabled) { transform: translateY(0.5px) scale(0.99); box-shadow: inset 0 2px 4px rgba(31, 35, 40, 0.16); }
      .btn:disabled { cursor: not-allowed; color: var(--fg-subtle); opacity: 0.6; }
      .btn-primary { color: var(--fg-on-emphasis); background: linear-gradient(180deg, color-mix(in srgb, var(--accent-emphasis) 88%, #ffffff 12%) 0%, var(--accent-emphasis) 100%); border-color: color-mix(in srgb, var(--accent-emphasis) 82%, #000000 18%); font-weight: 600; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 1px 3px rgba(9, 105, 218, 0.24); }
      .btn-primary:hover:not(:disabled) { color: var(--fg-on-emphasis); background: linear-gradient(180deg, var(--accent-emphasis) 0%, var(--accent-hover) 100%); border-color: color-mix(in srgb, var(--accent-hover) 80%, #000000 20%); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 3px 8px rgba(9, 105, 218, 0.32); transform: translateY(-0.5px); }
      .btn-primary:active:not(:disabled) { transform: translateY(0.5px) scale(0.99); box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.28); }
      .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border: 1px solid var(--border-default); border-radius: 8px; background: var(--canvas-default); overflow: hidden; box-shadow: 0 1px 3px rgba(31, 35, 40, 0.05); }
      .list:empty { display: none; border: 0; }
      .list li { background: transparent; border: 0; border-top: 1px solid var(--border-muted); border-radius: 0; transition: background 120ms ease; }
      .list li:first-child { border-top: 0; }
      .list li:hover { background: var(--canvas-subtle); }
      .list li > a { display: flex; align-items: center; gap: 10px; padding: 12px 16px; color: var(--fg-default); font-weight: 500; text-decoration: none; }
      .list li > a:hover { color: var(--accent-fg); }
      .list small { color: var(--fg-muted); margin-left: auto; font-size: 12px; font-variant-numeric: tabular-nums; }
      .badge { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 20px; padding: 0 8px; border-radius: 9999px; background: var(--accent-subtle); border: 1px solid var(--accent-muted); color: var(--accent-fg); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
      .tag { display: inline-flex; align-items: center; padding: 1px 8px; border: 1px solid var(--border-default); border-radius: 9999px; background: var(--canvas-subtle); color: var(--fg-muted); font-size: 12px; font-weight: 500; }
      footer { padding-block: 20px 36px; margin-top: 24px; border-top: 1px solid var(--border-default); color: var(--fg-muted); font-size: 12px; text-align: center; }
      footer .sep { margin: 0 8px; color: var(--fg-subtle); } [hidden] { display: none !important; }
      @media(max-width:40rem) { .topbar, main, footer { padding-inline: 16px; } .topbar nav { gap: 8px; } main { padding-block: 16px 32px; } .nav-actions { width: 100%; margin: 0; } .card-pad { padding: 16px; } }
      @media(prefers-reduced-motion:reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } .series-grid li, #search-results li { transition: none !important; transform: none !important; } }
    </style>
  </head>
  <body>
    <div class="topbar">
      <nav aria-label="位置">
        <a class="brand" href="/">
          <img class="mark" src={logo} alt="" width="34" height="34" /><span>{site.title}</span>
        </a>
        {
          crumbs.length > 0 && (
            <div class="crumbs">
              <span aria-hidden="true">›</span>
              {crumbs.map((c) => (
                <>
                  {c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
                  <span aria-hidden="true">›</span>
                </>
              ))}
            </div>
          )
        }
        <span class="spacer"></span>
        <div class="nav-actions">
          {showLibrary && <a class="pill" href="/library/" aria-current={url === '/library/' ? 'page' : undefined}>我的书架</a>}
          {showSearch && <a class="pill" href="/search/">搜索台词</a>}
          <label class="color-scheme-control" data-color-scheme-control hidden>
            <span>配色</span>
            <select id="color-scheme-select" aria-label="页面配色">
              <option value="system">跟随系统</option>
              <option value="light">浅色</option>
              <option value="dark">深色</option>
            </select>
          </label>
        </div>
      </nav>
      <p id="color-scheme-status" role="status" aria-live="polite" hidden></p>
    </div>
    <main><slot /></main>
    <footer>
      <a href="/">回首页</a>
      {showLibrary && <><span class="sep">·</span><a href="/library/">我的书架</a></>}
      {showSearch && <><span class="sep">·</span><a href="/search/">搜索台词</a></>}
      {tagline && <><span class="sep">·</span><span>{tagline}</span></>}
    </footer>
    <script src="/day-night-switch.js" is:inline></script>
    <script>
      import { mountDayNightControl } from '../lib/day-night-control.js';
      mountDayNightControl(window, document);
    </script>
    <style is:global>
      /* 明暗切换：颜色无极过渡 */
      html.dn-color-shift body,
      html.dn-color-shift * {
        transition:
          background-color 0.7s cubic-bezier(0.4, 0, 0.2, 1),
          color 0.7s cubic-bezier(0.4, 0, 0.2, 1),
          border-color 0.7s cubic-bezier(0.4, 0, 0.2, 1),
          fill 0.7s cubic-bezier(0.4, 0, 0.2, 1),
          stroke 0.7s cubic-bezier(0.4, 0, 0.2, 1),
          outline-color 0.7s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      @media (prefers-reduced-motion: reduce) {
        html.dn-color-shift body, html.dn-color-shift * { transition: none !important; }
      }
    </style>
  </body>
</html>
