---
// 所有页面共用的外壳：lang / title / viewport / canonical / og:title、站点外观、内联样式、
// 导航与页脚。不用 UI 框架——站点要在三平台的纯静态基线上跑（铁律 2），每话一个 HTML 又
// 有 18 000 份的量级（ARCHITECTURE §2），外壳越薄越好；样式随 inlineStylesheets=always 内联，
// dist 里不多出一个文件。
//
// 语义色与标题字体来自唯一配置源，默认暖纸白与青绿交互色。
// 字体只用系统栈，不引外部字体请求（离线可用）。
//
// props：
//   title    页面标题（不含站名；空则只用站名）
//   url      站内路径（以 / 开头、/ 结尾），拼 canonical 与 og:url 用；域名来自 site.config.yaml
//   crumbs   面包屑 [{ text, href? }]，首页那一级由外壳自己加
//   noindex  真则不出 canonical、加 robots noindex（404 页用）
import siteConfig from '../generated/site-config.json';
import { appearanceVariables } from '../lib/site-appearance.js';
import { initializeColorScheme } from '../lib/color-scheme.js';

const { site } = siteConfig;
const appearance = siteConfig.appearance ?? {};
const variables = appearanceVariables(appearance);
const darkVariables = appearanceVariables(appearance, 'dark');
const declarations = (values) => Object.entries(values).map(([key, value]) => `${key}:${value};`).join('');
const lightCSS = declarations(variables);
const darkCSS = declarations(darkVariables);
const paletteCSS = `:root{${lightCSS}}@media(prefers-color-scheme:dark){:root:not([data-color-scheme="light"]){${darkCSS}}}:root[data-color-scheme="dark"]{${darkCSS}}`;
const colorSchemeScript = `(${initializeColorScheme.toString()})(window,document);`;
const logo = site.logo ?? '/favicon.svg';
const tagline = site.tagline ?? '在页间，遇见好故事';
const showSearch = appearance.show_search !== false;
const showLibrary = appearance.show_library !== false;
const { title = '', url = '/', crumbs = [], description = tagline } = Astro.props;
const noindex = Boolean(Astro.props.noindex || siteConfig.preview);
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = `https://${site.domain}${url}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={variables['--bg-mid']} media="(prefers-color-scheme: light)" data-color-scheme-meta="light" />
    <meta name="theme-color" content={darkVariables['--bg-mid']} media="(prefers-color-scheme: dark)" data-color-scheme-meta="dark" />
    <style id="site-color-palettes" is:inline set:html={paletteCSS} />
    <script id="color-scheme-bootstrap" is:inline set:html={colorSchemeScript} />
    <link rel="icon" href={logo} />
    <title>{fullTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {description && <meta name="description" content={description} />}
    <slot name="head" />
    <style is:global>
      /* 共享语义色：正文、交互、表面与阅读标注各自取同一组变量。 */
      :root {
        color-scheme: var(--color-scheme);
        --radius: 16px;
        --font-serif: 'EB Garamond', 'Noto Serif SC', 'Songti SC', Georgia, serif;
        --font-sans: 'Inter', 'Noto Sans SC', system-ui, -apple-system, 'Segoe UI', sans-serif;
        /* 基础页面与检索组件共用的简写。 */
        --bg: var(--bg-mid);
        --fg: var(--ink);
        --muted: var(--text-dim);
        --link: var(--accent-strong);
      }
      * { box-sizing: border-box; }
      ::selection { background: var(--selection); color: var(--ink); }
      :focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 3px; }
      input, select, button { accent-color: var(--accent); }
      html { background: var(--bg-mid); }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.7;
        background:
          radial-gradient(1000px 700px at 10% -10%, var(--glow-one), transparent 64%),
          radial-gradient(900px 620px at 95% 0%, var(--glow-two), transparent 60%),
          radial-gradient(1000px 700px at 50% 100%, var(--glow-three), transparent 60%),
          linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 46%, var(--bg-low) 100%);
        background-attachment: fixed;
      }
      a { color: var(--accent-strong); text-decoration: none; transition: color 0.18s ease; }
      a:hover { color: var(--accent-alt); }
      h1, h2, h3 { color: var(--ink); font-family: var(--font-heading); font-weight: 600; letter-spacing: 0.01em; }
      h1 { font-size: clamp(1.9rem, 4.6vw, 2.7rem); line-height: 1.25; margin: 0.4rem 0 0.9rem; }
      h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin: 1.6rem 0 0.8rem; }
      .topbar, main, footer { max-width: 68rem; margin: 0 auto; padding-left: clamp(1rem, 3vw, 1.75rem); padding-right: clamp(1rem, 3vw, 1.75rem); }
      /* 顶部导航与页面共用主题表面色。 */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        max-width: none;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        background: var(--surface-raised);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(14px) saturate(1.2);
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
      }
      .topbar nav { display: flex; align-items: center; flex-wrap: wrap; gap: 0.55rem; max-width: 68rem; margin: 0 auto; font-size: 0.92rem; }
      .brand { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink); font-family: var(--font-heading); font-weight: 600; letter-spacing: 0.02em; }
      .brand:hover { color: var(--accent-strong); }
      .brand .mark {
        display: block;
        width: 2.15rem;
        height: 2.15rem;
        border-radius: 0.65rem;
        flex: 0 0 auto;
        object-fit: contain;
      }
      .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem; color: var(--text-dim); min-width: 0; }
      .crumbs a { color: var(--text-dim); }
      .crumbs a:hover { color: var(--accent-strong); }
      .crumbs span[aria-hidden] { opacity: 0.55; margin: 0 0.15rem; }
      .topbar .spacer { flex: 1; }
      .nav-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; margin-left: auto; }
      .color-scheme-control { align-items: center; gap: 0.35rem; color: var(--text-dim); font-size: 0.8rem; }
      .color-scheme-control:not([hidden]) { display: inline-flex; }
      .color-scheme-control select { max-width: 8rem; padding: 0.28rem 0.45rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface-soft); color: var(--ink); font: inherit; }
      #color-scheme-status { width: 100%; max-width: 68rem; margin: 0.35rem auto 0; color: var(--text-dim); font-size: 0.75rem; }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.28rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--surface-soft);
        color: var(--accent-alt);
        font-size: 0.85rem;
      }
      .pill:hover { color: var(--accent-strong); border-color: var(--accent-soft); background: var(--surface); }
      main { padding-top: clamp(1.2rem, 3vw, 2rem); padding-bottom: 3rem; }
      .muted { color: var(--text-dim); }
      .lede { color: var(--text-dim); max-width: 46rem; }
      .eyebrow { margin: 0 0 0.35rem; color: var(--accent-alt); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }
      /* 纸色卡片与按钮。 */
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .card-pad { padding: clamp(1rem, 2.4vw, 1.5rem); }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.62rem 1.2rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--accent-alt);
        font-family: inherit;
        font-size: 0.95rem;
        cursor: pointer;
        transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
      }
      .btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: var(--shadow); color: var(--accent-strong); }
      .btn:disabled { cursor: not-allowed; color: var(--text-dim); background: var(--surface-soft); box-shadow: none; }
      .btn-primary { color: var(--on-accent); border-color: var(--line); background: var(--accent); box-shadow: var(--shadow); }
      .btn-primary:hover:not(:disabled) { color: var(--on-accent); box-shadow: var(--shadow-hover); }
      /* 列表：每行一张轻阴影卡片。 */
      .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
      .list li {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--shadow);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
      }
      .list li:hover { transform: translateY(-1px); border-color: var(--accent-soft); box-shadow: var(--shadow-hover); }
      .list li > a { display: flex; align-items: baseline; gap: 0.55rem; padding: 0.8rem 1rem; color: var(--ink); font-weight: 500; }
      .list li > a:hover { color: var(--accent-strong); }
      .list small { color: var(--text-dim); margin-left: auto; font-weight: 400; white-space: nowrap; }
      .badge {
        display: inline-grid;
        place-items: center;
        min-width: 2.15rem;
        height: 2.15rem;
        padding: 0 0.45rem;
        border-radius: 0.6rem;
        background: var(--accent-soft);
        border: 1px solid var(--line);
        color: var(--accent-alt);
        font-size: 0.82rem;
        font-variant-numeric: tabular-nums;
      }
      .tag { display: inline-block; padding: 0.1rem 0.55rem; border-radius: 999px; border: 1px solid var(--line); color: var(--text-dim); font-size: 0.75rem; }
      footer { padding-top: 1.6rem; padding-bottom: 2.2rem; margin-top: 2rem; border-top: 1px solid var(--line); color: var(--text-dim); font-size: 0.85rem; text-align: center; }
      footer a { color: var(--accent-strong); }
      footer .sep { margin: 0 0.5rem; opacity: 0.5; }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <div class="topbar">
      <nav aria-label="位置">
        <a class="brand" href="/">
          <img class="mark" src={logo} alt="" width="34" height="34" /><span>{site.title}</span>
        </a>
        {
          crumbs.length > 0 && (
            <div class="crumbs">
              <span aria-hidden="true">›</span>
              {crumbs.map((c) => (
                <>
                  {c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
                  <span aria-hidden="true">›</span>
                </>
              ))}
            </div>
          )
        }
        <span class="spacer"></span>
        <div class="nav-actions">
          {showLibrary && <a class="pill" href="/library/" aria-current={url === '/library/' ? 'page' : undefined}>我的书架</a>}
          {showSearch && <a class="pill" href="/search/">搜索台词</a>}
          <label class="color-scheme-control" data-color-scheme-control hidden>
            <span>配色</span>
            <select id="color-scheme-select" aria-label="页面配色">
              <option value="system">跟随系统</option>
              <option value="light">浅色</option>
              <option value="dark">深色</option>
            </select>
          </label>
        </div>
      </nav>
      <p id="color-scheme-status" role="status" aria-live="polite" hidden></p>
    </div>
    <main><slot /></main>
    <footer>
      <a href="/">回首页</a>
      {showLibrary && <><span class="sep">·</span><a href="/library/">我的书架</a></>}
      {showSearch && <><span class="sep">·</span><a href="/search/">搜索台词</a></>}
      {tagline && <><span class="sep">·</span><span>{tagline}</span></>}
    </footer>
  </body>
</html>
