---
// 所有页面共用的外壳：lang / title / viewport / canonical / og:title、站点外观、内联样式、
// 导航与页脚。不用 UI 框架——站点要在三平台的纯静态基线上跑（铁律 2），每话一个 HTML 又
// 有 18 000 份的量级（ARCHITECTURE §2），外壳越薄越好；样式随 inlineStylesheets=always 内联，
// dist 里不多出一个文件。
//
// 语义色与标题字体来自唯一配置源，默认使用 Enterprise 品牌蓝与中性表面。
// 字体随静态产物提供，不依赖外部字体服务。
//
// props：
//   title    页面标题（不含站名；空则只用站名）
//   url      站内路径（以 / 开头、/ 结尾），拼 canonical 与 og:url 用；域名来自 site.config.yaml
//   crumbs   面包屑 [{ text, href? }]，首页那一级由外壳自己加
//   noindex  真则不出 canonical、加 robots noindex（404 页用）
import siteConfig from '../generated/site-config.json';
import { appearanceVariables } from '../lib/site-appearance.js';
import { initializeColorScheme } from '../lib/color-scheme.js';

const { site } = siteConfig;
const appearance = siteConfig.appearance ?? {};
const variables = appearanceVariables(appearance);
const darkVariables = appearanceVariables(appearance, 'dark');
const declarations = (values) => Object.entries(values).map(([key, value]) => `${key}:${value};`).join('');
const lightCSS = declarations(variables);
const darkCSS = declarations(darkVariables);
const paletteCSS = `:root{${lightCSS}}@media(prefers-color-scheme:dark){:root:not([data-color-scheme="light"]){${darkCSS}}}:root[data-color-scheme="dark"]{${darkCSS}}`;
const colorSchemeScript = `(${initializeColorScheme.toString()})(window,document);`;
const logo = site.logo ?? '/favicon.svg';
const tagline = site.tagline ?? '在页间，遇见好故事';
const showSearch = appearance.show_search !== false;
const showLibrary = appearance.show_library !== false;
const { title = '', url = '/', crumbs = [], description = tagline } = Astro.props;
const noindex = Boolean(Astro.props.noindex || siteConfig.preview);
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = `https://${site.domain}${url}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={variables['--bg-mid']} media="(prefers-color-scheme: light)" data-color-scheme-meta="light" />
    <meta name="theme-color" content={darkVariables['--bg-mid']} media="(prefers-color-scheme: dark)" data-color-scheme-meta="dark" />
    <style id="site-color-palettes" is:inline set:html={paletteCSS} />
    <script id="color-scheme-bootstrap" is:inline set:html={colorSchemeScript} />
    <link rel="icon" href={logo} />
    <title>{fullTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {description && <meta name="description" content={description} />}
    <slot name="head" />
    <script>import { mountPageMotion } from '../lib/page-motion.js'; mountPageMotion();</script>
    <style is:global>
      @font-face { font-family: 'IBM Plex Sans'; src: url('/fonts/ibm-plex-sans-latin-400.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'IBM Plex Sans'; src: url('/fonts/ibm-plex-sans-latin-700.woff2') format('woff2'); font-weight: 700; font-display: swap; }
      :root { color-scheme: var(--color-scheme); --radius: 8px;
        --font-sans: 'IBM Plex Sans', 'Microsoft YaHei', system-ui, sans-serif;
        --font-serif: 'Noto Serif SC', 'Songti SC', Georgia, serif;
        --bg: var(--bg-mid); --fg: var(--ink); --muted: var(--text-dim); --link: var(--accent-strong);
      }
      * { box-sizing: border-box; }
      ::selection { background: var(--selection); color: var(--ink); }
      :focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 3px; }
      input, select, button { accent-color: var(--accent); font: inherit; }
      html { background: var(--bg-mid); }
      body { margin: 0; min-height: 100vh; color: var(--text); font: 16px/1.7 var(--font-sans); background: var(--bg-mid); }
      a { color: var(--accent-strong); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1, h2, h3 { color: var(--ink); font-family: var(--font-heading); font-weight: 700; letter-spacing: -.015em; }
      h1 { font-size: 32px; line-height: 1.25; margin: 8px 0 16px; }
      h2 { font-size: 24px; line-height: 1.3; margin: 40px 0 16px; }
      h3 { font-size: 20px; line-height: 1.4; }
      .topbar, main, footer { max-width: 72rem; margin: 0 auto; padding-inline: 24px; }
      .topbar { position: sticky; top: 0; z-index: 20; max-width: none; padding-block: 16px; background: var(--surface); }
      .topbar nav { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; max-width: 72rem; margin: auto; font-size: 14px; }
      .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font: 700 20px/1.2 var(--font-sans); }
      .brand .mark { width: 32px; height: 32px; border-radius: 4px; flex: none; object-fit: contain; }
      .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--text-dim); min-width: 0; }
      .crumbs a { color: var(--text-dim); } .crumbs span[aria-hidden] { margin: 0 4px; }
      .topbar .spacer { flex: 1; } .nav-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-left: auto; }
      .color-scheme-control { align-items: center; gap: 8px; color: var(--text-dim); font-size: 12px; }
      .color-scheme-control:not([hidden]) { display: inline-flex; }
      .color-scheme-control select { max-width: 8rem; min-height: 40px; padding: 8px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg-mid); color: var(--ink); font: inherit; }
      #color-scheme-status { width: 100%; max-width: 72rem; margin: 8px auto 0; color: var(--text-dim); font-size: 12px; }
      .pill { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 8px 16px; border-radius: 4px; background: var(--bg-mid); color: var(--accent-strong); font-size: 14px; }
      .pill:hover { background: var(--accent-soft); text-decoration: none; }
      main { padding-block: 40px 64px; } .muted, .lede { color: var(--text-dim); } .lede { max-width: 46rem; }
      .eyebrow { margin: 0 0 8px; color: var(--accent-strong); font: 700 12px/1.5 var(--font-sans); letter-spacing: .08em; }
      .card { background: var(--surface); border: 0; border-radius: 8px; }
      .card-pad { padding: 24px; }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px 16px; border-radius: 4px; border: 0; background: var(--surface-soft); color: var(--accent-strong); font: 500 16px/1.5 var(--font-sans); cursor: pointer; }
      .btn:hover:not(:disabled) { background: var(--accent-soft); text-decoration: none; }
      .btn:disabled { cursor: not-allowed; color: var(--text-dim); }
      .btn-primary { color: var(--on-accent); background: var(--accent); }
      .btn-primary:hover:not(:disabled) { color: var(--on-accent); background: var(--accent); filter: brightness(.9); }
      .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
      .list li { background: var(--surface); border: 0; border-radius: 4px; }
      .list li:hover { background: var(--surface-soft); }
      .list li > a { display: flex; align-items: baseline; gap: 8px; padding: 16px; color: var(--ink); font-weight: 500; }
      .list small { color: var(--text-dim); margin-left: auto; font-size: 14px; }
      .badge { display: inline-grid; place-items: center; min-width: 32px; height: 32px; padding: 0 8px; border-radius: 4px; background: var(--accent-soft); color: var(--accent-strong); font-size: 12px; font-variant-numeric: tabular-nums; }
      .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; background: var(--surface-soft); color: var(--text-dim); font-size: 12px; }
      footer { padding-block: 24px 40px; margin-top: 24px; color: var(--text-dim); font-size: 14px; text-align: center; }
      footer .sep { margin: 0 8px; } [hidden] { display: none !important; }
      @media(max-width:40rem) { .topbar, main, footer { padding-inline: 16px; } .topbar nav { gap: 8px; } main { padding-block: 24px 40px; } .nav-actions { width: 100%; margin: 0; } .card-pad { padding: 16px; } }
      @media(prefers-reduced-motion:reduce) { *, *::before, *::after { scroll-behavior: auto !important; } .series-grid li, #search-results li { transition: none !important; transform: none !important; } }
    </style>
  </head>
  <body>
    <div class="topbar">
      <nav aria-label="位置">
        <a class="brand" href="/">
          <img class="mark" src={logo} alt="" width="34" height="34" /><span>{site.title}</span>
        </a>
        {
          crumbs.length > 0 && (
            <div class="crumbs">
              <span aria-hidden="true">›</span>
              {crumbs.map((c) => (
                <>
                  {c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
                  <span aria-hidden="true">›</span>
                </>
              ))}
            </div>
          )
        }
        <span class="spacer"></span>
        <div class="nav-actions">
          {showLibrary && <a class="pill" href="/library/" aria-current={url === '/library/' ? 'page' : undefined}>我的书架</a>}
          {showSearch && <a class="pill" href="/search/">搜索台词</a>}
          <label class="color-scheme-control" data-color-scheme-control hidden>
            <span>配色</span>
            <select id="color-scheme-select" aria-label="页面配色">
              <option value="system">跟随系统</option>
              <option value="light">浅色</option>
              <option value="dark">深色</option>
            </select>
          </label>
        </div>
      </nav>
      <p id="color-scheme-status" role="status" aria-live="polite" hidden></p>
    </div>
    <main><slot /></main>
    <footer>
      <a href="/">回首页</a>
      {showLibrary && <><span class="sep">·</span><a href="/library/">我的书架</a></>}
      {showSearch && <><span class="sep">·</span><a href="/search/">搜索台词</a></>}
      {tagline && <><span class="sep">·</span><span>{tagline}</span></>}
    </footer>
  </body>
</html>
