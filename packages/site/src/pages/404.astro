---
// 404：GitHub Pages 认 dist/404.html，Cloudflare Pages / EdgeOne 也用它。不出 canonical、标 noindex。
import Base from '../layouts/Base.astro';
---

<Base title="404" url="/404/" noindex>
  <section class="not-found card card-pad">
    <p class="eyebrow">Page not found</p>
    <h1>404</h1>
    <p class="lede">没有这一页。链接可能已失效，请返回首页浏览。</p>
    <p><a class="btn btn-primary" href="/">回首页 →</a></p>
  </section>
</Base>

<style>
  .not-found { text-align: center; padding: 3rem 1.5rem; }
  .not-found h1 { font-size: clamp(3rem, 12vw, 5rem); margin: 0.2rem 0 0.6rem; }
  .not-found .lede { margin: 0 auto 1.2rem; }
</style>
