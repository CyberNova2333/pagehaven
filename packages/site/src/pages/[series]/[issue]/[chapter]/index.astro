  .reader .icon-btn { display: inline-grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--accent-alt); font-size: 0.95rem; cursor: pointer; }
