---
// 阅读器：每话恰好一个 HTML（ARCHITECTURE §2：文件数预算不允许每页一个），全部页的 <img> 与文字层
// 都在这一份里，翻页在页内完成，#p<n> 深链定位到某一页。
//
// 渐进增强：初始 DOM 全部页纵向可见、文字层是普通 DOM 文本——没有 JS 时照样能读、能选、爬虫能看见；
// 页尾的内联脚本一跑才切成单页模式。脚本内联是为了紧跟阅读器 DOM 同步执行，不先闪全部页。
//
// 功能（有 JS 时）：单页 / 长条 / 双页、阅读方向、全屏、亮度、页码跳转、目录侧栏、
// 阅读进度记忆（localStorage，首页「继续阅读」读它）、触摸滑动、图片失败重试。
// hash 约定（检索结果也按这个链过来）：#p<n>、#p<n>b<i>（高亮第 i 个框）。
// 键盘：←/→ 翻页、空格下一页、f 全屏、t 目录、Esc 关闭面板。
import Base from '../../../../layouts/Base.astro';
import EnhancedReader from '../../../../components/EnhancedReader.astro';
import ChapterToc from '../../../../components/ChapterToc.astro';
import ReaderBookmarks from '../../../../components/ReaderBookmarks.astro';
import siteConfig from '../../../../generated/site-config.json';
import gallery from '../../../../generated/gallery.json';
import { boxStyle, chaptersByKey, imageUrl, isDot, urlForKey } from '../../../../lib/gallery.js';

export function getStaticPaths() {
  const byKey = chaptersByKey(gallery);
  const link = (key) => {
    if (!key) return null;
    const c = byKey.get(key);
    if (!c) throw new Error(`gallery.json 里 prev/next 指向不存在的话：${key}`);
    return { key: c.key, title: c.title };
  };
  return gallery.series.flatMap((s) =>
    s.issues.flatMap((iss) =>
      iss.chapters.map((c) => ({
        params: { series: s.id, issue: iss.id, chapter: c.id },
        props: { series: s, issue: iss, chapter: c, prev: link(c.prev), next: link(c.next) },
      })),
    ),
  );
}

const textModules = import.meta.glob('/src/generated/text/**/*.json', { import: 'default' });

const { series, issue, chapter, prev, next } = Astro.props;
const { images, features } = siteConfig;
const hosts = images.hosts;
const wantText = features.text_layer && chapter.hasText;
const loadText = textModules[`/src/generated/text/${chapter.key}.json`];
if (wantText && !loadText) {
  throw new Error(`${chapter.key} 标记 hasText 但 src/generated/text/ 下没有对应分片——先跑 npm run build:site`);
}
const text = wantText ? await loadText() : { pages: [] };
const boxesByN = new Map(text.pages.map((p) => [p.n, p.boxes]));

const total = chapter.pages.length;
const boxCount = text.pages.reduce((n, p) => n + p.boxes.length, 0);

---

<Base
  title={`${chapter.title} · ${issue.title} · ${series.title}`}
  url={chapter.url}
  crumbs={[{ text: series.title, href: series.url }, { text: issue.title, href: issue.url }, { text: chapter.title }]}
>
  <h1>{chapter.title}</h1>
  <p class="muted chapter-meta">
    {series.title} · {issue.title} · 共 {total} 页{boxCount ? ` · ${boxCount} 条台词` : ''}
  </p>

  <nav class="chapter-nav" aria-label="上一话 / 下一话">
    {prev ? <a rel="prev" href={urlForKey(prev.key)}>← 上一话：{prev.title}</a> : <span></span>}
    <a href={issue.url}>目录</a>
    {next ? <a rel="next" href={urlForKey(next.key)}>下一话：{next.title} →</a> : <span></span>}
  </nav>


  <div
    id="reader"
    class="reader"
    data-hosts={JSON.stringify(hosts)}
    data-total={total}
    data-key={chapter.key}
    data-url={chapter.url}
    data-title={chapter.title}
    data-series={series.title}
    data-issue={issue.title}
  >
    <div class="progress" aria-hidden="true"><span id="progress-fill"></span></div>
    <p class="pager">
      <button id="toc-btn" aria-controls="toc" aria-expanded="false" type="button" class="icon-btn" aria-label="目录" title="目录（t）">☰</button>
      <a id="page-prev" href="#p1" hidden>← 上一页</a>
      <span class="page-indicator">
        第 <input id="page-input" type="number" min="1" max={total} value="1" inputmode="numeric" aria-label="页码" /> / {total} 页
      </span>
      <a id="page-next" href="#p2" hidden={total <= 1}>下一页 →</a>
      <button id="settings-btn" type="button" class="icon-btn" aria-label="阅读设置" title="阅读设置">⚙</button>
      <button id="fullscreen-btn" type="button" class="icon-btn" aria-label="全屏" title="全屏（f）">⛶</button>
      {boxCount > 0 && (
        <label class="text-toggle"><input type="checkbox" id="text-toggle" /> 显示文字</label>
      )}
    </p>

    <ReaderBookmarks />
    <ChapterToc series={series} issue={issue} chapter={chapter} />

    <div id="settings" class="settings card" hidden aria-label="阅读设置">
      <p class="settings-row"><span>模式</span>
        <label><input type="radio" name="reader-mode" value="single" /> 单页</label>
        <label><input type="radio" name="reader-mode" value="long" /> 长条</label>
        <label><input type="radio" name="reader-mode" value="double" /> 双页</label>
      </p>
      <p class="settings-row"><span>方向</span>
        <label><input type="radio" name="reader-dir" value="ltr" /> 左→右</label>
        <label><input type="radio" name="reader-dir" value="rtl" /> 右→左</label>
      </p>
      <p class="settings-row"><span>亮度</span>
        <input id="brightness" type="range" min="40" max="100" value="100" />
      </p>
      {features.comimi_reader && <EnhancedReader />}
      <p class="settings-row settings-note">快捷键：← / → 翻页，空格下一页，f 全屏，t 目录，Esc 关闭</p>
    </div>

    {features.comimi_reader && <>
      <p id="enhanced-status" class="muted enhanced-status" role="status" hidden></p>
      <div id="enhanced-viewer" class="enhanced-stage" aria-label="漫画分页阅读" hidden></div>
    </>}

    {
      chapter.pages.map((p) => {
        const boxes = boxesByN.get(p.n) ?? [];
        return (
          <section class="page" id={`p${p.n}`} data-n={p.n}>
            <p class="page-num muted">第 {p.n} 页</p>
            <div class="image-feedback" hidden>
              <p class="image-message" role="status"></p>
              <button class="image-retry btn" type="button" aria-label={`重试第 ${p.n} 页图片`} hidden>重试本页</button>
            </div>
            <div class="frame" style={`aspect-ratio:${p.w}/${p.h}`}>
              <img
                src={imageUrl(hosts[0], p.keys.webp)}
                loading="lazy"
                decoding="async"
                width={p.w}
                height={p.h}
                alt={`${chapter.title} 第 ${p.n} 页`}
              />
              {boxes.length > 0 && (
                <div class="text-layer">
                  {boxes.map((b) => (
                    <span class:list={['box', { dot: isDot(b) }]} id={`p${p.n}b${b.i}`} style={boxStyle(b)}>{b.t}</span>
                  ))}
                </div>
              )}
            </div>
          </section>
        );
      })
    }
  </div>

  <nav class="chapter-nav" aria-label="上一话 / 下一话">
    {prev ? <a rel="prev" href={urlForKey(prev.key)}>← 上一话：{prev.title}</a> : <span></span>}
    <a href={issue.url}>目录</a>
    {next ? <a rel="next" href={urlForKey(next.key)}>下一话：{next.title} →</a> : <span></span>}
  </nav>

  <script>
    import { mountReaderImages } from '../../../../lib/reader-images.js';
    const reader = document.getElementById('reader');
    if (reader) mountReaderImages(reader, { hosts: JSON.parse(reader.dataset.hosts || '[]') });
  </script>

  <script is:inline>
    (function () {
      var reader = document.getElementById('reader');
      if (!reader) return;
      var pages = Array.prototype.slice.call(reader.querySelectorAll('.page'));
      var total = pages.length;
      if (!total) return;

      var key = reader.dataset.key;
      var progressKey = 'gallery:progress:' + key;
      var settingsKey = 'gallery:reader:settings';
      var curEl = document.getElementById('page-input');
      var prevLink = document.getElementById('page-prev');
      var nextLink = document.getElementById('page-next');
      var fill = document.getElementById('progress-fill');
      var toggle = document.getElementById('text-toggle');
      var toc = document.getElementById('toc');
      var settingsPanel = document.getElementById('settings');
      var brightness = document.getElementById('brightness');
      var cur = 1;
      var requestedPage = 1;
      var hl = null;
      var scrollFrame = 0;
      var restoringLong = false;
      var longRestoreId = 0;
      var longRestoreFrame = 0;
      var longRestoreReady = null;
      var enhancement = null;
      var subscribers = [];
      var settings = loadSettings();

      function readerState() {
        return { page: cur, requestedPage: requestedPage, mode: settings.mode, dir: settings.dir };
      }
      function notify() {
        subscribers.slice().forEach(function (fn) { fn(readerState()); });
      }
      reader.galleryReader = {
        getState: readerState,
        subscribe: function (fn) {
          subscribers.push(fn);
          return function () { subscribers = subscribers.filter(function (item) { return item !== fn; }); };
        },
        showPage: function (n) { show(n, {}); },
        setEnhancement: function (adapter) { enhancement = adapter; },
        refresh: function () { applyHash(false); },
      };

      function loadSettings() {
        var d = { mode: 'single', dir: 'ltr', brightness: 100 };
        try {
          var s = JSON.parse(localStorage.getItem(settingsKey) || '{}');
          if (s.mode === 'single' || s.mode === 'long' || s.mode === 'double') d.mode = s.mode;
          if (s.dir === 'ltr' || s.dir === 'rtl') d.dir = s.dir;
          if (typeof s.brightness === 'number') d.brightness = s.brightness;
        } catch (e) {
          /* 坏设置用默认 */
        }
        return d;
      }
      function saveSettings() {
        try {
          localStorage.setItem(settingsKey, JSON.stringify(settings));
        } catch (e) {
          /* 隐私模式写不进去就算了 */
        }
      }
      function applySettings() {
        reader.classList.remove('mode-single', 'mode-long', 'mode-double');
        reader.classList.add('mode-' + settings.mode);
        reader.classList.toggle('rtl', settings.dir === 'rtl');
        reader.style.setProperty('--reader-brightness', String(settings.brightness / 100));
        if (brightness) brightness.value = String(settings.brightness);
        var modeInput = settingsPanel.querySelector('input[name="reader-mode"][value="' + settings.mode + '"]');
        if (modeInput) modeInput.checked = true;
        var dirInput = settingsPanel.querySelector('input[name="reader-dir"][value="' + settings.dir + '"]');
        if (dirInput) dirInput.checked = true;
        // 长条模式保留原生 lazy，只让浏览器加载视口附近的页。
        updateProgress();
        notify();
      }

      function parseHash(h) {
        var m = /^#p(\d+)(?:b(\d+))?$/.exec(h || '');
        return m ? { n: +m[1], b: m[2] === undefined ? null : +m[2] } : null;
      }
      function clamp(n) {
        return Math.min(Math.max(n, 1), total);
      }
      function step() {
        return !enhancement && settings.mode === 'double' ? 2 : 1;
      }
      function updateProgress() {
        if (!fill) return;
        var pct;
        if (settings.mode === 'long') {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          pct = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        } else {
          pct = cur / total;
        }
        fill.style.width = (pct * 100).toFixed(2) + '%';
      }
      function updateLongPage() {
        if (settings.mode !== 'long' || restoringLong) return;
        // 搜索命中的气泡会居中，页面顶部此时可能仍是上一页；气泡仍可见就保留命中页。
        if (hl) {
          var box = hl.getBoundingClientRect();
          if (box.bottom >= 0 && box.top <= window.innerHeight) return;
        }
        // 以视口上部的阅读位置判定当前页，留出顶部导航的空间。
        var marker = Math.min(window.innerHeight / 3, 200);
        var n = 1;
        // 长条页按 DOM 顺序纵向排列；二分找最后一个顶部已到达标记的页，避免逐帧扫描整章。
        // 每次读取实时布局，不缓存坐标，图片加载或视口变化后仍按当前位置判页。
        var low = 1;
        var high = total - 1;
        while (low <= high) {
          var mid = Math.floor((low + high) / 2);
          if (pages[mid].getBoundingClientRect().top > marker) high = mid - 1;
          else {
            n = mid + 1;
            low = mid + 1;
          }
        }
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1) n = total;
        requestedPage = n;
        if (n === cur) return;
        cur = n;
        if (curEl) curEl.value = String(n);
        saveProgress(n);
        // 同一页内滚动保留检索气泡的深链，跨页后才更新 hash。
        var target = parseHash(location.hash);
        if (!target || target.n !== n) {
          highlight(n, null);
          history.replaceState(null, '', '#p' + n);
        }
        notify();
      }
      function onScroll() {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(function () {
          scrollFrame = 0;
          updateLongPage();
          updateProgress();
        });
      }
      function warm(n) {
        var p = pages[n - 1];
        var img = p && p.querySelector('img');
        if (img && img.loading === 'lazy') img.loading = 'eager';
        var p2 = pages[n];
        var img2 = p2 && p2.querySelector('img');
        if (img2 && img2.loading === 'lazy') img2.loading = 'eager';
      }
      function saveProgress(n) {
        if (restoringLong) return;
        try {
          localStorage.setItem(
            progressKey,
            JSON.stringify({
              url: reader.dataset.url,
              title: reader.dataset.title,
              series: reader.dataset.series,
              issue: reader.dataset.issue,
              n: n,
              ts: Date.now(),
            }),
          );
        } catch (e) {
          /* 写不进去就算了 */
        }
      }
      function show(n, opts) {
        opts = opts || {};
        n = clamp(n);
        // 增强阅读器可能在窄屏改成单页，接管时仍需知道跨页归并前的目标。
        requestedPage = n;
        if (!enhancement && settings.mode === 'double' && n % 2 === 0) n -= 1;
        pages.forEach(function (p, i) {
          p.classList.toggle('current', i === n - 1);
        });
        if (settings.mode === 'double' && pages[n]) pages[n].classList.add('current');
        cur = n;
        if (curEl) curEl.value = String(n);
        if (prevLink) {
          prevLink.hidden = n <= 1;
          prevLink.href = '#p' + Math.max(n - step(), 1);
        }
        if (nextLink) {
          nextLink.hidden = n + (!enhancement && settings.mode === 'double' ? 1 : 0) >= total;
          nextLink.href = '#p' + Math.min(n + step(), total);
        }
        if (!opts.keepHash) history.replaceState(null, '', '#p' + n);
        saveProgress(n);
        updateProgress();
        if (settings.mode !== 'long') warm(n + 1);
        if (opts.scroll) {
          if (settings.mode === 'long') pages[n - 1].scrollIntoView({ block: 'start' });
          else reader.scrollIntoView();
        }
        notify();
      }
      function highlight(n, b) {
        if (hl) hl.classList.remove('hl');
        hl = b === null ? null : document.getElementById('p' + n + 'b' + b);
        if (hl) {
          hl.classList.add('hl');
          hl.scrollIntoView({ block: 'center' });
        }
      }
      function cancelLongRestore() {
        longRestoreId++;
        restoringLong = false;
        if (longRestoreFrame) window.cancelAnimationFrame(longRestoreFrame);
        if (longRestoreReady) document.removeEventListener('DOMContentLoaded', longRestoreReady);
        longRestoreFrame = 0;
        longRestoreReady = null;
      }
      function restoreLongPage(n, b, scroll) {
        cancelLongRestore();
        var restoreId = longRestoreId;
        restoringLong = true;
        n = clamp(n);
        show(n, { keepHash: true });
        // 内联脚本执行时页尾尚未解析。等完整文档布局后定位，避免短末页被旧滚动上限截住。
        var start = function () {
          longRestoreReady = null;
          longRestoreFrame = window.requestAnimationFrame(function () {
            if (restoreId !== longRestoreId) return;
            show(n, { keepHash: true, scroll: scroll });
            highlight(n, b);
            // 程序触发的 scroll 可能晚于定位到达；此帧内仍不得覆盖恢复目标。
            longRestoreFrame = window.requestAnimationFrame(function () {
              if (restoreId !== longRestoreId) return;
              longRestoreFrame = 0;
              restoringLong = false;
              saveProgress(cur);
              updateProgress();
            });
          });
        };
        if (document.readyState === 'loading') {
          longRestoreReady = start;
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else start();
      }
      function applyHash(scroll) {
        cancelLongRestore();
        var t = parseHash(location.hash);
        if (t) {
          if (settings.mode === 'long') restoreLongPage(t.n, t.b, true);
          else {
            show(t.n, { keepHash: true, scroll: scroll });
            highlight(t.n, t.b);
          }
          return;
        }
        // 没有 hash：恢复本话的上次进度（首页「继续阅读」也靠这份记录）
        var resumed = 1;
        try {
          var saved = JSON.parse(localStorage.getItem(progressKey) || 'null');
          if (saved && saved.n) resumed = saved.n;
        } catch (e) {
          /* 坏记录忽略 */
        }
        if (settings.mode === 'long') restoreLongPage(resumed, null, resumed > 1);
        else show(resumed, { keepHash: true });
        if (resumed > 1 && settings.mode !== 'long') {
          var tip = document.getElementById('resume-tip');
          if (!tip) {
            tip = document.createElement('p');
            tip.id = 'resume-tip';
            tip.className = 'muted resume-tip';
            reader.parentNode.insertBefore(tip, reader);
          }
          tip.textContent = '已恢复到第 ' + resumed + ' 页';
        }
      }
      function go(delta) {
        if (enhancement) {
          enhancement.navigate(delta);
          return;
        }
        if (settings.mode === 'long') {
          window.scrollBy({ top: delta * window.innerHeight * 0.9, behavior: 'smooth' });
          return;
        }
        // delta 永远表示章节顺序；按钮与空格不会因阅读方向而倒退。
        var n = cur + delta * step();
        if (n < 1 || n > total) return;
        highlight(n, null);
        show(n);
        if (settings.mode !== 'long') reader.scrollIntoView({ block: 'nearest' });
      }
      function goPhysical(delta) {
        // 只有左右键、点击区域、滑动需要从物理方向映射到章节顺序。
        go(settings.dir === 'rtl' ? -delta : delta);
      }
      function openPanel(el, open) {
        if (!el) return;
        el.hidden = !open;
      }
      function closeAll() {
        openPanel(toc, false);
        openPanel(settingsPanel, false);
      }

      reader.classList.add('js');
      applySettings();
      applyHash(false);

      if (curEl) {
        curEl.addEventListener('change', function () {
          var n = parseInt(curEl.value, 10);
          if (!isNaN(n)) show(n);
        });
      }
      if (prevLink) {
        prevLink.addEventListener('click', function (e) {
          e.preventDefault();
          go(-1);
        });
      }
      if (nextLink) {
        nextLink.addEventListener('click', function (e) {
          e.preventDefault();
          go(1);
        });
      }
      var tocBtn = document.getElementById('toc-btn');
      var tocClose = document.getElementById('toc-close');
      var settingsBtn = document.getElementById('settings-btn');
      var fsBtn = document.getElementById('fullscreen-btn');
      if (tocBtn) tocBtn.addEventListener('click', function () { openPanel(toc, toc.hidden); openPanel(settingsPanel, false); });
      if (tocClose) tocClose.addEventListener('click', function () { openPanel(toc, false); });
      if (settingsBtn) settingsBtn.addEventListener('click', function () { openPanel(settingsPanel, settingsPanel.hidden); openPanel(toc, false); });
      if (fsBtn) {
        fsBtn.addEventListener('click', function () {
          if (document.fullscreenElement) document.exitFullscreen();
          else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
        });
      }
      settingsPanel.addEventListener('change', function (e) {
        var t = e.target;
        if (t.name === 'reader-mode') {
          updateLongPage();
          cancelLongRestore();
          settings.mode = t.value;
        } else if (t.name === 'reader-dir') settings.dir = t.value;
        else if (t.id === 'brightness') settings.brightness = Number(t.value);
        else return;
        saveSettings();
        applySettings();
        if (settings.mode !== 'long') show(cur);
        if (settings.mode === 'long') {
          var target = parseHash(location.hash);
          restoreLongPage(cur, target && target.n === cur ? target.b : null, true);
        }
      });
      if (brightness) {
        brightness.addEventListener('input', function () {
          settings.brightness = Number(brightness.value);
          reader.style.setProperty('--reader-brightness', String(settings.brightness / 100));
        });
      }
      window.addEventListener('hashchange', function () { applyHash(true); });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // 离开页面时同步保存，避免最后一次滚动还排在下一帧。
      window.addEventListener('pagehide', updateLongPage);
      document.addEventListener('keydown', function (e) {
        if (enhancement) return;
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
        if (e.key === 'Escape' && (!toc.hidden || !settingsPanel.hidden)) {
          var returnTo = !toc.hidden ? tocBtn : settingsBtn;
          closeAll();
          if (returnTo) returnTo.focus();
          e.preventDefault();
          return;
        }
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON' || t.tagName === 'SELECT' || t.tagName === 'A' || t.isContentEditable || t.closest?.('.toc, .settings'))) return;
        if (e.key === 'ArrowLeft') goPhysical(-1);
        else if (e.key === 'ArrowRight') goPhysical(1);
        else if (e.key === ' ') go(1);
        else if (e.key === 'f') {
          if (document.fullscreenElement) document.exitFullscreen();
          else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
        } else if (e.key === 't') {
          openPanel(toc, toc.hidden);
          openPanel(settingsPanel, false);
        } else if (e.key === 'Escape') closeAll();
        else return;
        e.preventDefault();
      });
      reader.addEventListener('click', function (e) {
        if (enhancement) return;
        if (e.target.closest('.box') || e.target.closest('a') || e.target.closest('button') || e.target.closest('input') || e.target.closest('.toc') || e.target.closest('.settings')) return;
        var frame = e.target.closest('.frame');
        if (!frame) return;
        var sel = window.getSelection();
        if (sel && sel.toString()) return;
        var r = frame.getBoundingClientRect();
        goPhysical(e.clientX - r.left < r.width / 2 ? -1 : 1);
      });
      // 触摸滑动（单页/双页模式）
      var touchX = null;
      reader.addEventListener('touchstart', function (e) {
        touchX = null;
        if (enhancement || settings.mode === 'long' || e.touches.length !== 1) return;
        if (e.target.closest('button, input, textarea, select, a, .toc, .settings, .box, .reader-bookmarks')) return;
        touchX = e.touches[0].clientX;
      }, { passive: true });
      reader.addEventListener('touchend', function (e) {
        if (enhancement) { touchX = null; return; }
        if (touchX === null) return;
        var dx = e.changedTouches[0].clientX - touchX;
        touchX = null;
        if (Math.abs(dx) < 50) return;
        goPhysical(dx < 0 ? 1 : -1);
      });
      if (toggle) {
        toggle.addEventListener('change', function () {
          reader.classList.toggle('show-text', toggle.checked);
        });
      }
    })();
  </script>
</Base>

