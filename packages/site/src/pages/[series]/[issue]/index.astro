---
// 期页：话列表（number、title、页数、有无台词稿）。
import Base from '../../../layouts/Base.astro';
import siteConfig from '../../../generated/site-config.json';
import gallery from '../../../generated/gallery.json';

export function getStaticPaths() {
  return gallery.series.flatMap((s) =>
    s.issues.map((iss) => ({ params: { series: s.id, issue: iss.id }, props: { series: s, issue: iss } })),
  );
}

const { series, issue } = Astro.props;
// 「有台词」只在文字层开着时标：features.text_layer 关了阅读器就没有文字层，列表不该还承诺。
// hasText 本身是数据（索引分片里照写），这里管的只是展示。
const showText = siteConfig.features.text_layer;
---

<Base
  title={`${issue.title} · ${series.title}`}
  url={issue.url}
  crumbs={[{ text: series.title, href: series.url }, { text: issue.title }]}
>
  <section class="page-head card card-pad">
    <p class="eyebrow">Issue</p>
    <h1>{issue.title}</h1>
    <p class="muted head-meta">
      {series.title} · {issue.chapters.length} 话{issue.published ? ` · ${issue.published}` : ''}
    </p>
  </section>

  <h2>话</h2>
  <ul class="list">
    {
      issue.chapters.map((c) => (
        <li>
          <a href={c.url}>
            <span class="badge">{c.number}</span>
            <span class="row-title">{c.title}</span>
            <small>{c.pages.length} 页{showText && c.hasText ? ' · 有台词' : ''}</small>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .page-head { margin-bottom: 1.2rem; }
  .head-meta { margin: 0; }
  .row-title { flex: 1; min-width: 0; }
</style>
