---
// 首页：hero（首个作品的封面 / 简介 / 标签 / 统计）+ 继续阅读 + 作品卡片（封面）+ 各作品最新一话 + 随机。
import Base from '../layouts/Base.astro';
import siteConfig from '../generated/site-config.json';
import gallery from '../generated/gallery.json';
import { chapterCount, imageUrl, jsonForScript } from '../lib/gallery.js';

const { site, images } = siteConfig;
const cover = (s) => (s.coverKey ? imageUrl(images.hosts[0], s.coverKey) : null);
const STATUSB = { ongoing: '连载中', completed: '已完结', hiatus: '休载', cancelled: '已终止' };
const seriesCount = gallery.series.length;
const issueCount = gallery.series.reduce((n, s) => n + s.issues.length, 0);
const chapterTotal = gallery.series.reduce((n, s) => n + chapterCount(s), 0);
const featured = gallery.series[0] ?? null;
const allChapters = gallery.series.flatMap((s) => s.issues.flatMap((iss) => iss.chapters.map((c) => ({
  url: c.url, title: c.title, series: s.title, issue: iss.title, pages: c.pages.length,
}))));
// 每个作品的最新一话（数组顺序即模型顺序：期按 number、话按 number）
const latest = gallery.series
  .map((s) => {
    const iss = s.issues.filter((issue) => issue.chapters.length > 0).at(-1);
    const ch = iss?.chapters[iss.chapters.length - 1];
    return ch ? { series: s, issue: iss, chapter: ch } : null;
  })
  .filter(Boolean);
---

<Base url="/">
  {
    featured ? (
      <section class="hero card">
        <a class="hero-cover" href={featured.url} aria-hidden="true">
          {cover(featured) ? (
            <img src={cover(featured)} alt="" width="600" height="879" loading="eager" />
          ) : (
            <span class="cover-fallback">{featured.title.slice(0, 2)}</span>
          )}
        </a>
        <div class="hero-body">
          <p class="eyebrow">精选故事 · {site.title}</p>
          <h1>{featured.title}</h1>
          {featured.description && <p class="lede">{featured.description}</p>}
          <div class="tag-row">
            {featured.authors?.length > 0 && <span class="tag">作者：{featured.authors.join(' / ')}</span>}
            {featured.status && <span class="tag">{STATUSB[featured.status] ?? featured.status}</span>}
            {featured.tags?.map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="hero-actions">
            <a class="btn btn-primary" href={featured.url}>开始阅读 →</a>
            {siteConfig.appearance?.show_search !== false && <a class="btn" href="/search/">搜索台词</a>}
            <button class="btn" id="random-btn" type="button">随机一话</button>
          </div>
          <dl class="stats">
            <div><dt>作品</dt><dd>{seriesCount}</dd></div>
            <div><dt>期</dt><dd>{issueCount}</dd></div>
            <div><dt>话</dt><dd>{chapterTotal}</dd></div>
          </dl>
        </div>
      </section>
    ) : (
      <section class="card card-pad">
        <p class="eyebrow">A home for stories</p>
        <h1>{site.title}</h1>
        <p class="lede">还没有作品。内容发布后，会在这里显示作品目录。</p>
      </section>
    )
  }

  <section id="continue" class="continue card card-pad" hidden>
    <h2>继续阅读</h2>
    <ul class="continue-list" id="continue-list"></ul>
  </section>

  {gallery.series.length > 0 && <h2 id="series">作品</h2>}
  {
    gallery.series.length > 0 && (
      <ul class="series-grid">
        {gallery.series.map((s) => (
          <li class="card">
            <a class="series-card" href={s.url}>
              <span class="series-cover">
                {cover(s) ? (
                  <img src={cover(s)} alt="" loading="lazy" width="600" height="879" />
                ) : (
                  <span class="cover-fallback">{s.title.slice(0, 2)}</span>
                )}
              </span>
              <span class="series-info">
                <span class="series-title">{s.title}</span>
                <span class="series-meta">
                  {s.authors?.join(' / ') || '—'} · {s.issues.length} 期 · {chapterCount(s)} 话
                </span>
                {s.status && <span class="tag">{STATUSB[s.status] ?? s.status}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    latest.length > 0 && (
      <>
        <h2>各作品最新一话</h2>
        <ul class="list">
          {latest.map(({ series, issue, chapter }) => (
            <li>
              <a href={chapter.url}>
                <span class="badge">{chapter.number}</span>
                <span class="row-title">{series.title} · {issue.title}</span>
                <small>{chapter.title}</small>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <script type="application/json" id="random-pool" set:html={jsonForScript(allChapters)} />
  <script is:inline>
    (function () {
      var chapters = JSON.parse(document.getElementById('random-pool').textContent || '[]');
      var pool = chapters.map(function (c) { return c.url; });
      var currentChapters = new Map(chapters.map(function (c) { return [c.url, c]; }));
      var btn = document.getElementById('random-btn');
      if (btn) {
        btn.addEventListener('click', function () {
          if (pool.length) location.href = pool[Math.floor(Math.random() * pool.length)];
        });
      }
      // 继续阅读：阅读器把 {url,title,series,issue,n,ts} 写进 localStorage
      var list = document.getElementById('continue-list');
      var wrap = document.getElementById('continue');
      if (!list || !wrap) return;
      var records = new Map();
      try {
        var storage = localStorage;
        for (var i = 0; i < storage.length; i++) {
          try {
            var k = storage.key(i);
            if (!k || k.indexOf('gallery:progress:') !== 0) continue;
            var v = JSON.parse(storage.getItem(k));
            if (!v || typeof v !== 'object' || Array.isArray(v)) continue;
            var chapter = currentChapters.get(v.url);
            if (!chapter) continue;
            // URL、标题与页数以当前目录为准；旧页码只在现存页范围内恢复。
            var n = Number.isSafeInteger(v.n) ? Math.max(1, Math.min(chapter.pages, v.n)) : 1;
            var ts = Number.isFinite(v.ts) && v.ts >= 0 ? v.ts : 0;
            var previous = records.get(chapter.url);
            if (!previous || ts > previous.ts) records.set(chapter.url, { chapter: chapter, n: n, ts: ts });
          } catch (e) {
            /* 单条坏数据跳过 */
          }
        }
      } catch (e) {
        /* 浏览器禁止访问存储时，仅省略继续阅读。 */
      }
      var items = Array.from(records.values());
      items.sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); });
      items.slice(0, 3).forEach(function (v) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = v.chapter.url + '#p' + v.n;
        a.textContent = v.chapter.title;
        var small = document.createElement('small');
        small.textContent = [v.chapter.series, v.chapter.issue].filter(Boolean).join(' · ');
        li.appendChild(a);
        li.appendChild(small);
        list.appendChild(li);
      });
      if (items.length) wrap.hidden = false;
    })();
  </script>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(12rem, 16rem) 1fr; gap: clamp(1rem, 3vw, 2rem); padding: clamp(1rem, 2.4vw, 1.5rem); margin-bottom: 2rem; }
  @media (max-width: 40rem) { .hero { grid-template-columns: 1fr; } .hero-cover { max-width: 10rem; } }
  .hero-cover { display: block; border-radius: 8px; overflow: hidden; background: var(--cover-bg); aspect-ratio: 600 / 879; }
  .hero-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-body { min-width: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.1rem 0 1.4rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.6rem 0 0; }
  .stats { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .stats div { display: flex; flex-direction: column; gap: 0.1rem; }
  .stats dt { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .stats dd { margin: 0; font-family: var(--font-heading); font-size: 24px; color: var(--ink); }
  .continue { margin-bottom: 1.6rem; }
  .continue h2 { margin-top: 0; }
  .continue-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .continue-list li { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 0.8rem; border-radius: 8px; background: var(--surface-soft); border: 0; }
  .continue-list a { color: var(--ink); font-weight: 500; }
  .continue-list small { color: var(--text-dim); }
  .series-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .series-grid li { transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease; overflow: hidden; }
  .series-grid li:hover { transform: translateY(-2px); border-color: var(--accent-soft); box-shadow: none; }
  .series-card { display: flex; gap: 0.8rem; padding: 0.8rem; color: var(--ink); align-items: flex-start; }
  .series-card:hover { color: var(--accent-strong); }
  .series-cover { flex: 0 0 5.2rem; width: 5.2rem; aspect-ratio: 600 / 879; border-radius: 8px; overflow: hidden; background: var(--cover-bg); }
  .series-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cover-fallback { display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent-alt); font-family: var(--font-heading); font-size: 24px; }
  .series-info { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .series-title { font-family: var(--font-heading); font-size: 20px; font-weight: 600; }
  .series-meta { color: var(--text-dim); font-size: 14px; }
  .row-title { flex: 1; min-width: 0; }
</style>
