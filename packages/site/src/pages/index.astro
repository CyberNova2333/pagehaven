---
// 首页：作品列表（按模型顺序，即 sort 再 title）与检索入口。
import Base from '../layouts/Base.astro';
import siteConfig from '../generated/site-config.json';
import gallery from '../generated/gallery.json';
import { chapterCount } from '../lib/gallery.js';

const { site } = siteConfig;
---

<Base url="/">
  <h1>{site.title}</h1>
  <p><a href="/search/">搜索台词 →</a></p>
  {
    gallery.series.length === 0 ? (
      <p class="muted">还没有作品。</p>
    ) : (
      <ul class="list">
        {gallery.series.map((s) => (
          <li>
            <a href={s.url}>{s.title}</a>
            <small>{s.issues.length} 期 · {chapterCount(s)} 话</small>
          </li>
        ))}
      </ul>
    )
  }
</Base>
