---
import Base from '../../layouts/Base.astro';
import gallery from '../../generated/gallery.json';
import config from '../../generated/site-config.json';
import { imageUrl, jsonForScript } from '../../lib/gallery.js';
import { READING_STATUSES } from '../../lib/library.js';

// 只在书架页携带恢复进度需要的目录，不重复嵌入每页图片和文字层。
const catalog = gallery.series.map((series) => ({
  id: series.id, title: series.title, url: series.url,
  coverUrl: series.coverKey ? imageUrl(config.images.hosts[0], series.coverKey) : null,
  authors: series.authors ?? [],
  issues: series.issues.map((issue) => ({
    id: issue.id, title: issue.title,
    chapters: issue.chapters.map((chapter) => ({
      key: chapter.key, title: chapter.title, url: chapter.url, pages: chapter.pages.length,
    })),
  })),
}));
---

<Base title="我的书架" url="/library/" noindex crumbs={[{ text: '我的书架' }]}>
  <section id="library-root" aria-busy="false">
    <header class="library-heading">
      <p class="eyebrow">Your reading corner</p>
      <h1>我的书架</h1>
      <p class="lede">把想读的故事留在这里，也可从最近阅读继续上次读到的那一页。</p>
      <p class="muted library-help">在作品页点击“加入书架”，再选择想读、在读或已读。书架保存在当前浏览器中。</p>
    </header>

    <section id="reading-overview" class="reading-overview card card-pad" aria-labelledby="overview-heading" hidden>
      <h2 id="overview-heading">阅读数据概览</h2>
      <dl class="overview-grid">
        <div><dt>收藏作品</dt><dd data-overview-field="savedSeries">—</dd></div>
        <div><dt>有进度作品</dt><dd data-overview-field="progressSeries">—</dd></div>
        <div><dt>有进度章节</dt><dd data-overview-field="progressChapters">—</dd></div>
        <div><dt>页码书签</dt><dd data-overview-field="bookmarks">—</dd></div>
        <div><dt>带文字备注书签</dt><dd data-overview-field="notes">—</dd></div>
      </dl>
      <p class="overview-status muted" data-overview-status role="status" aria-live="polite"></p>
      <p class="muted library-help">按页面恢复规则汇总当前目录中的可显示记录，不含独立备注和编辑中的草稿。备份另有校验并保留合法旧记录，条数可能不同；存储受限或本页未保存修改会单独提示。</p>
    </section>

    <div class="library-toolbar card card-pad" data-library-toolbar hidden>
      <label for="library-filter">阅读状态
        <select id="library-filter">
          <option value="all">全部</option>
          {READING_STATUSES.map((status) => <option value={status.value}>{status.label}</option>)}
        </select>
      </label>
      <label class="library-search" for="library-search">查找作品
        <input id="library-search" type="search" placeholder="作品名称或作者" autocomplete="off" />
      </label>
      <label for="library-sort">排列顺序
        <select id="library-sort">
          <option value="updated">最近更新书架</option>
          <option value="recent">最近阅读</option>
        </select>
      </label>
      <p id="library-count" class="muted" role="status" aria-live="polite"></p>
    </div>

    <p id="library-storage-note" class="library-notice" role="status" aria-live="polite" hidden></p>
    <p id="library-feedback" class="muted" role="status" aria-live="polite"></p>
    <div id="library-empty" class="card card-pad" role="status">启用浏览器脚本后，即可查看收藏的作品与阅读进度。</div>
    <ul id="library-list" class="library-grid" aria-label="书架作品" hidden></ul>

    <section id="reading-history" class="reading-history" aria-labelledby="history-heading">
      <h2 id="history-heading">最近阅读</h2>
      <p class="muted library-help">按最近阅读的章节继续，作品无需加入书架。每话保留最后一次已保存的位置，仅显示当前目录仍有效的记录。</p>
      <div class="library-toolbar card card-pad" data-history-toolbar hidden>
        <label class="library-search" for="history-search">查找阅读记录
          <input id="history-search" type="search" placeholder="作品、作者、期名或章节名" autocomplete="off" />
        </label>
        <button id="history-refresh" type="button" class="btn">刷新记录</button>
        <p id="history-count" class="muted" role="status" aria-live="polite"></p>
      </div>
      <p id="history-empty" class="card card-pad" role="status">启用浏览器脚本后，即可查看最近阅读。</p>
      <ul id="history-list" class="history-list" aria-label="最近阅读的章节" hidden></ul>
      <button id="history-more" class="btn" type="button" hidden>显示更多阅读记录</button>
    </section>

    <section id="library-bookmarks" class="library-bookmarks" aria-labelledby="bookmark-heading">
      <h2 id="bookmark-heading">页码书签</h2>
      <p class="muted library-help">从阅读页收藏喜欢的一页，在这里查看、添加备注或继续阅读。作品无需先加入书架。</p>
      <div class="library-toolbar card card-pad" data-bookmark-toolbar hidden>
        <label for="bookmark-filter">作品
          <select id="bookmark-filter">
            <option value="">全部作品</option>
            {catalog.map((series) => <option value={series.id}>{series.title}</option>)}
          </select>
        </label>
        <p id="bookmark-count" class="muted" role="status" aria-live="polite"></p>
      </div>
      <p id="bookmark-storage-note" class="library-notice" role="status" aria-live="polite" hidden></p>
      <p id="bookmark-feedback" class="muted" role="status" aria-live="polite"></p>
      <div id="bookmark-editor" class="card card-pad library-bookmark-editor" hidden>
        <h3 id="bookmark-editor-title"></h3>
        <label for="library-bookmark-note">备注（最多 200 字符）</label>
        <textarea id="library-bookmark-note" maxlength="200" rows="3"></textarea>
        <div class="library-item-actions">
          <button id="bookmark-save" class="btn btn-primary" type="button">保存备注</button>
          <button id="bookmark-cancel" class="btn" type="button">取消</button>
        </div>
      </div>
      <p id="bookmark-empty" class="card card-pad" role="status">启用浏览器脚本后，即可查看收藏的页码。</p>
      <ul id="bookmark-list" class="bookmark-list" aria-label="收藏的页码" hidden></ul>
      <button id="bookmark-more" class="btn" type="button" hidden>显示更多书签</button>
    </section>

    <section id="reading-backup" class="reading-backup card card-pad" aria-labelledby="backup-heading" aria-busy="false" hidden>
      <div class="backup-heading">
        <div><p class="eyebrow">Keep your place</p><h2 id="backup-heading">备份与恢复</h2></div>
        <span class="tag">仅在设备上处理</span>
      </div>
      <p class="muted library-help">下载书架、阅读进度、页码书签和备注，换设备或迁移域名时再恢复。只备份已保存的记录，文件不会上传。</p>
      <div class="backup-actions">
        <button class="btn btn-primary" id="backup-export" type="button">下载备份</button>
        <label class="backup-file" for="backup-file"><span>选择备份文件以预览恢复</span><input id="backup-file" type="file" accept="application/json,.json" aria-describedby="backup-help" /></label>
      </div>
      <p id="backup-help" class="muted library-help">支持本站导出的 JSON 备份，最多 5 MiB、20,000 条记录。恢复按作品和章节标识匹配；合法的旧目录记录也会保留。</p>
      <a class="backup-download" id="backup-download" hidden>再次下载刚才的备份</a>
      <div id="backup-preview" class="backup-preview" hidden>
        <h3>导入预览</h3>
        <label for="backup-mode" class="backup-mode">重复记录如何处理
          <select id="backup-mode">
            <option value="keep-existing">保留本机已有记录（推荐）</option>
            <option value="use-backup">相同记录使用备份内容</option>
          </select>
        </label>
        <p class="muted library-help">两种方式都会合并页码收藏，不删除备份之外的记录。“修复”表示用有效备份替换损坏记录。</p>
        <div class="backup-table-wrap"><table class="backup-table"><caption class="backup-caption">本次导入将如何处理各类记录</caption><thead><tr><th scope="col">记录</th><th scope="col">新增</th><th scope="col">替换</th><th scope="col">保留</th><th scope="col">修复</th></tr></thead><tbody id="backup-summary"></tbody></table></div>
        <p class="muted library-help" id="backup-details"></p>
        <div class="backup-actions"><button id="backup-apply" class="btn btn-primary" type="button" disabled>确认导入</button><button id="backup-cancel" class="btn" type="button">取消</button></div>
      </div>
      <button id="backup-refresh" class="btn" type="button" hidden>重新预览</button>
      <p id="backup-feedback" class="library-help" role="status" aria-live="polite"></p>
    </section>

    <p class="library-back"><a class="btn" href="/">浏览作品 →</a></p>
    <p class="muted library-help">收藏和状态只保存在本浏览器，不会自动跨设备同步。清除站点数据前请下载备份；移出书架会保留阅读进度。</p>
    <noscript><p class="library-notice">个人书架、阅读数据概览、最近阅读、备份与恢复需要启用 JavaScript 才能读取浏览器中的收藏和进度。仍可<a href="/">回首页浏览作品</a>。</p></noscript>
    <script id="library-catalog" type="application/json" set:html={jsonForScript(catalog)} />
  </section>
</Base>

<script>
  import { mountLibrary } from '../../lib/library-controls.js';
  import { mountBookmarkLibrary } from '../../lib/library-bookmarks.js';
  import { mountReadingBackup } from '../../lib/reading-backup-controls.js';
  import { mountReadingOverview } from '../../lib/reading-overview.js';
  const root = document.getElementById('library-root');
  const bookmarks = document.getElementById('library-bookmarks');
  const overviewRoot = document.getElementById('reading-overview');
  const overview = overviewRoot ? mountReadingOverview(overviewRoot) : null;
  let libraryController;
  let bookmarkController;
  const mountViews = () => {
    overview?.reset();
    if (root) libraryController = mountLibrary(root, { onSummary: overview?.updateLibrary });
    if (bookmarks) bookmarkController = mountBookmarkLibrary(bookmarks, { onSummary: overview?.updateBookmarks });
  };
  mountViews();
  const backup = document.getElementById('reading-backup');
  if (backup) mountReadingBackup(backup, {
    canTransfer: () => {
      if (bookmarkController?.isEditing) return '请先保存或取消正在编辑的书签备注，再备份或导入。';
      if (libraryController?.hasPending || bookmarkController?.hasPending) return '本页有尚未保存到浏览器的修改，请先重试保存，再备份或导入。';
      return '';
    },
    onImported: () => {
      libraryController?.destroy();
      bookmarkController?.destroy();
      mountViews();
    },
  });
</script>

<style is:global>
  .library-heading { margin-bottom: 1.5rem; }
  .library-heading h1 { margin: 0; }
  .library-heading .lede { margin-bottom: 0.5rem; }
  .library-help { font-size: 14px; }
  .reading-overview { margin-bottom: 1.5rem; }
  .reading-overview h2 { margin: 0 0 1rem; font-size: 20px; }
  .overview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); gap: 1rem; margin: 0; }
  .overview-grid dt { color: var(--text-dim); font-size: 13px; }
  .overview-grid dd { margin: 0.35rem 0 0; color: var(--ink); font-size: 28px; font-weight: 700; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .overview-status { min-height: 4.5em; font-size: 14px; margin-bottom: 0; }
  .library-toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; margin-bottom: 1rem; }
  .library-toolbar label { display: grid; gap: 0.35rem; font-size: 14px; }
  .library-toolbar input, .library-toolbar select, .library-item select {
    padding: 0.65rem 0.8rem; border: 1px solid var(--line); border-radius: 4px;
    background: var(--surface); color: var(--ink); font: inherit; min-height: 2.7rem;
  }
  .library-search { flex: 1; min-width: min(100%, 12rem); }
  .library-toolbar input { width: 100%; min-width: 0; }
  .library-toolbar p { margin: 0 0 0.6rem; font-size: 14px; }
  .library-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .library-item { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; padding: 1.1rem; }
  .library-cover { display: block; aspect-ratio: 600 / 879; background: var(--cover-bg); border-radius: 4px; overflow: hidden; color: var(--accent-alt); }
  .library-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .library-cover span { display: grid; place-items: center; height: 100%; font-family: var(--font-serif); font-size: 24px; }
  .library-item h2 { margin: 0 0 0.35rem; font-size: 20px; overflow-wrap: anywhere; }
  .library-item p { margin: 0.3rem 0; font-size: 14px; overflow-wrap: anywhere; }
  .library-item-body { min-width: 0; }
  .library-item-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.7rem; }
  .library-item-actions .btn { padding: 0.5rem 0.8rem; font-size: 14px; }
  .library-item-status { display: grid; gap: 0.3rem; font-size: 12px; color: var(--text-dim); }
  .library-item select { max-width: 100%; font-size: 14px; }
  .library-notice { border-left: 3px solid var(--highlight); padding: 0.7rem 1rem; background: var(--surface-soft); border-radius: 4px; font-size: 14px; }
  .library-back { margin-top: 1.4rem; }
  .reading-backup { margin-top: 2.3rem; scroll-margin-top: 8rem; }
  .backup-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.8rem; }
  .backup-heading h2 { margin: 0; }
  .backup-heading .eyebrow { margin: 0 0 0.2rem; }
  .backup-actions { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin: 1rem 0; }
  .backup-file, .backup-mode { display: grid; gap: 0.35rem; font-size: 14px; min-width: 0; max-width: 100%; }
  .backup-file input { max-width: 100%; color: var(--text); font: inherit; }
  .backup-file input::file-selector-button { border: 1px solid var(--line); border-radius: 4px; background: var(--surface-soft); color: var(--ink); padding: 0.55rem 0.8rem; margin-right: 0.6rem; font: inherit; cursor: pointer; }
  .backup-mode select { padding: 0.6rem; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--ink); font: inherit; }
  .backup-preview { border-top: 1px solid var(--line); margin-top: 1.2rem; padding-top: 0.8rem; }
  .backup-preview h3 { margin: 0.5rem 0 0.8rem; }
  .backup-table-wrap { overflow-x: auto; }
  .backup-table { border-collapse: collapse; width: 100%; text-align: left; font-size: 14px; }
  .backup-caption { text-align: left; color: var(--text-dim); margin-bottom: 0.5rem; }
  .backup-table th, .backup-table td { padding: 0.6rem 0.4rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .backup-table td { font-variant-numeric: tabular-nums; }
  .backup-download { font-size: 14px; }
  #backup-feedback { overflow-wrap: anywhere; }
  #backup-feedback:empty { display: none; }
  #library-feedback:empty { display: none; }
  .library-bookmarks { margin-top: 2.3rem; scroll-margin-top: 8rem; }
  .reading-history { margin-top: 2.3rem; scroll-margin-top: 8rem; }
  .history-list { display: grid; gap: 0.8rem; list-style: none; padding: 0; }
  .history-row h3 { margin: 0; font-size: 16px; overflow-wrap: anywhere; }
  .history-row p { margin: 0.5rem 0; overflow-wrap: anywhere; }
  .history-row time { font-size: 14px; }
  .bookmark-list { display: grid; gap: 0.8rem; list-style: none; padding: 0; }
  .bookmark-row h3 { margin: 0; font-size: 16px; }
  .bookmark-row p { margin: 0.5rem 0; }
  .bookmark-row .bookmark-body { white-space: pre-wrap; overflow-wrap: anywhere; }
  .library-bookmark-editor { margin-bottom: 1rem; }
  .library-bookmark-editor h3 { margin: 0 0 0.7rem; }
  .library-bookmark-editor textarea { display: block; width: 100%; box-sizing: border-box; resize: vertical; padding: 0.7rem; margin: 0.5rem 0; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; }
  #bookmark-feedback:empty { display: none; }
  #library-root [hidden] { display: none; }
  @media (max-width: 48rem) { .library-grid { grid-template-columns: 1fr; } }
  @media (max-width: 24rem) { .library-item { grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0.7rem; } }
</style>
