// This file is part of Pagehaven · 页间 and is licensed under GNU AGPLv3 with Additional Terms (see LICENSE and LICENSE-ADDITIONAL_TERMS-zh-CN.md; ref: LICENSE-ADDITIONAL_TERMS-en.md).
// 检索页：作品/作者/标签过滤（纯前端读 /index/series.json）+ 台词检索（sqlite-wasm，packages/search）。
// 页面结构约定（别改）：#search-form / #search-input / #search-results / #search-status / #search-config。
import Base from '../../layouts/Base.astro';
import siteConfig from '../../generated/site-config.json';
import gallery from '../../generated/gallery.json';
import { jsonForScript } from '../../lib/gallery.js';

const { images, db, search, features } = siteConfig;
const chapters = gallery.series.flatMap((s) => s.issues.flatMap((issue) => issue.chapters));
const coverage = {
  chapters: chapters.length,
  withText: chapters.filter((chapter) => chapter.hasText).length,
  boxes: gallery.totals.boxes,
};
const noText = coverage.withText === 0 || coverage.boxes === 0;
const noContent = coverage.chapters === 0;
const searchConfig = {
  images: { hosts: images.hosts },
  db: { page_size: db.page_size, chunk_size: db.chunk_size, prefix: db.prefix, whole_download_max_bytes: db.whole_download_max_bytes, release: gallery.searchDb ?? null },
  search: { request_chunk_size: search.request_chunk_size, min_match_length: search.min_match_length, api_path: search.api_path },
  features: { search_function: features.search_function },
  coverage,
};
---

<Base title="搜索" url="/search/" crumbs={[{ text: '搜索' }]}>
  <h1>搜索</h1>
  <nav class="search-modes" aria-label="搜索类型" id="search-modes" hidden>
    <a class="btn" id="lines" href="#lines" aria-controls="line-search" aria-current="true">搜台词</a>
    <a class="btn" id="titles" href="#titles" aria-controls="title-search">找作品</a>
  </nav>

  <div id="line-search">
    <section class="search-head card card-pad">
      <h2>搜索台词</h2>
      <form id="search-form" role="search" action="/search/" method="get">
        <input id="search-input" name="q" type="search" aria-label="台词片段" placeholder="输入台词片段，例如「希望」" autocomplete="off" />
        <select id="search-series" name="series" aria-label="限定作品">
          <option value="">全部作品</option>
          {gallery.series.map((series) => <option value={series.id}>{series.title}</option>)}
        </select>
        <button class="btn btn-primary" type="submit">搜索</button>
      </form>
      <p id="search-coverage" class="muted">台词稿覆盖 {coverage.withText} / {coverage.chapters} 话，共 {coverage.boxes} 个文本框。</p>
      <p id="search-status" class="muted" aria-live="polite">{noContent ? '当前还没有作品，内容发布后即可检索。' : noText ? '当前尚未收录可检索的台词，作品和漫画仍可正常浏览。' : '输入至少 2 个字开始检索。'}</p>
      <p class="muted note">
        仅检索已经收录的台词稿；尚未录入文字的漫画不会出现在台词结果中。
        至少输入 2 个字，可选择作品缩小范围。首次搜索需要加载数据。
      </p>
    </section>

    <ol id="search-results"></ol>
    <button id="search-more" class="btn" type="button" hidden>加载更多台词</button>
  </div>

  <section id="title-search" class="card card-pad" hidden>
    <h2>查找作品</h2>
    <form id="meta-form" role="search">
      <input id="meta-q" type="search" aria-label="作品名、别名、作者或标签" placeholder="作品名 / 别名 / 作者 / 标签" autocomplete="off" />
      <button class="btn" type="submit">过滤</button>
    </form>
    <p id="meta-status" class="muted" aria-live="polite">{noContent ? '当前还没有作品，内容发布后即可检索。' : ''}</p>
    <ul id="meta-results" class="list"></ul>
    <button id="meta-more" class="btn" type="button" hidden>加载更多作品</button>
  </section>

  <noscript>
    <p class="muted">检索在浏览器里完成，需要 JavaScript。可从<a href="/#series">首页作品目录</a>进入阅读。</p>
  </noscript>

  <script type="application/json" id="search-config" set:html={jsonForScript(searchConfig)} />
  <script>
    import { mountSearch } from 'pagehaven:search-page';
    import { mountTitleSearch } from '../../lib/title-search.js';

    const modes = document.getElementById('search-modes')!;
    const titles = document.getElementById('title-search')!;
    const lines = document.getElementById('line-search')!;
    const titlesLink = document.getElementById('titles')!;
    const linesLink = document.getElementById('lines')!;
    let titlesReady = false;
    let lineSearch: ReturnType<typeof mountSearch>;

    function selectMode() {
      const target = document.getElementById(location.hash.slice(1));
      const showTitles = target === titlesLink || titles.contains(target);
      titles.hidden = !showTitles;
      lines.hidden = showTitles;
      const activeLink = showTitles ? titlesLink : linesLink;
      const otherLink = showTitles ? linesLink : titlesLink;
      activeLink.setAttribute('aria-current', 'true');
      otherLink.removeAttribute('aria-current');
      if (showTitles && !titlesReady) {
        titlesReady = true;
        mountTitleSearch(document);
      } else if (!showTitles) {
        if (lineSearch) lineSearch.restoreFromUrl();
        else lineSearch = mountSearch();
      }
    }

    selectMode();
    modes.hidden = false;
    window.addEventListener('hashchange', selectMode);
    window.addEventListener('popstate', selectMode);
  </script>
</Base>

<style>
  .search-modes { display: flex; gap: 8px; margin: 0 0 12px; }
  .search-modes[hidden] { display: none; }
  .search-modes a { scroll-margin-top: 8rem; }
  .search-modes a[aria-current] { background: var(--accent-fg); color: var(--canvas-default); border-color: var(--accent-fg); }
  #meta-form, #search-form { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
  #meta-q, #search-input, #search-series {
    flex: 1;
    min-width: 12rem;
    min-height: 28px;
    padding: 4px 10px;
    font: 13.5px/18px var(--font-sans);
    color: var(--fg-default);
    background: var(--canvas-inset);
    border: 1px solid var(--border-default);
    border-radius: 6px;
    outline: none;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  #meta-q::placeholder, #search-input::placeholder { color: var(--fg-subtle); }
  #meta-q:focus, #search-input:focus, #search-series:focus-visible { border-color: var(--accent-fg); box-shadow: 0 0 0 3px var(--accent-subtle); background: var(--canvas-default); }
  #search-series { flex: 0 1 auto; min-width: 8rem; }
  #search-more, #meta-more { margin-top: 16px; }
  #search-more[hidden], #meta-more[hidden] { display: none; }
  #meta-status, #search-status { margin: 4px 0 12px; font-size: 13px; }
  .note { font-size: 13px; line-height: 1.5; margin: 0; }
  #search-results { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 0; border: 1px solid var(--border-default); border-radius: 6px; background: var(--canvas-default); overflow: hidden; }
  #search-results:empty { display: none; border: 0; }
  #search-results li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    padding: 7px 12px;
    background: transparent;
    border-top: 1px solid var(--border-muted);
    box-shadow: none;
    transition: background 120ms ease;
  }
  #search-results li:first-child { border-top: 0; }
  #search-results li:hover { background: var(--canvas-subtle); box-shadow: none; }
  #search-results li a { color: var(--fg-default); font-weight: 500; }
  #search-results li a:hover { color: var(--accent-fg); }
  #search-results li small { color: var(--fg-muted); font-size: 12px; }
</style>
