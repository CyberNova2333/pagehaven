---
// 检索页：作品/作者/标签过滤（纯前端读 /index/series.json）+ 台词检索（sqlite-wasm，packages/search）。
// 页面结构约定（别改）：#search-form / #search-input / #search-results / #search-status / #search-config。
import Base from '../../layouts/Base.astro';
import siteConfig from '../../generated/site-config.json';
import gallery from '../../generated/gallery.json';
import { jsonForScript } from '../../lib/gallery.js';

const { images, db, search, features } = siteConfig;
const chapters = gallery.series.flatMap((s) => s.issues.flatMap((issue) => issue.chapters));
const coverage = {
  chapters: chapters.length,
  withText: chapters.filter((chapter) => chapter.hasText).length,
  boxes: gallery.totals.boxes,
};
const noText = coverage.withText === 0 || coverage.boxes === 0;
const noContent = coverage.chapters === 0;
const searchConfig = {
  images: { hosts: images.hosts },
  db: { page_size: db.page_size, chunk_size: db.chunk_size, prefix: db.prefix, whole_download_max_bytes: db.whole_download_max_bytes, release: gallery.searchDb ?? null },
  search: { request_chunk_size: search.request_chunk_size, min_match_length: search.min_match_length, api_path: search.api_path },
  features: { search_function: features.search_function },
  coverage,
};
---

<Base title="搜索" url="/search/" crumbs={[{ text: '搜索' }]}>
  <section class="meta-head card card-pad">
    <p class="eyebrow">Titles</p>
    <h1>搜索</h1>
    <form id="meta-form" role="search">
      <input id="meta-q" type="search" aria-label="作品名、作者或标签" placeholder="作品名 / 作者 / 标签" autocomplete="off" />
      <button class="btn" type="submit">过滤</button>
    </form>
    <p id="meta-status" class="muted" aria-live="polite">{noContent ? '当前还没有作品，内容发布后即可检索。' : ''}</p>
    <ul id="meta-results" class="list"></ul>
  </section>

  <section class="search-head card card-pad">
    <p class="eyebrow">Lines</p>
    <h2>搜索台词</h2>
    <form id="search-form" role="search" action="/search/" method="get">
      <input id="search-input" name="q" type="search" aria-label="台词片段" placeholder="输入台词片段，例如「希望」" autocomplete="off" />
      <select id="search-series" name="series" aria-label="限定作品">
        <option value="">全部作品</option>
        {gallery.series.map((series) => <option value={series.id}>{series.title}</option>)}
      </select>
      <button class="btn btn-primary" type="submit">搜索</button>
    </form>
    <p id="search-coverage" class="muted">台词稿覆盖 {coverage.withText} / {coverage.chapters} 话，共 {coverage.boxes} 个文本框。</p>
    <p id="search-status" class="muted" aria-live="polite">{noContent ? '当前还没有作品，内容发布后即可检索。' : noText ? '当前尚未收录可检索的台词，作品和漫画仍可正常浏览。' : '输入至少 2 个字开始检索。'}</p>
    <p class="muted note">
      仅检索已经收录的台词稿；尚未录入文字的漫画不会出现在台词结果中。
      至少输入 2 个字，可选择作品缩小范围。首次搜索需要加载数据。
    </p>
  </section>

  <ol id="search-results"></ol>
  <button id="search-more" class="btn" type="button" hidden>加载更多台词</button>
  <noscript>
    <p class="muted">检索在浏览器里完成，需要 JavaScript。作品与话页面不受影响。</p>
  </noscript>

  <script type="application/json" id="search-config" set:html={jsonForScript(searchConfig)} />
  <script>
    import { mountSearch } from '@gallery/search';

    // 懒加载：进页面只接线，不下载检索库；第一次搜索才加载（30 MB 以内整份下载 + sha256 校验）。
    mountSearch();
  </script>

  <script is:inline>
    (function () {
      var form = document.getElementById('meta-form');
      var input = document.getElementById('meta-q');
      var list = document.getElementById('meta-results');
      var status = document.getElementById('meta-status');
      if (!form || !input || !list || !status) return;
      var cache = null;
      var sequence = 0;
      function load() {
        if (!cache) {
          cache = fetch('/index/series.json')
            .then(function (r) {
              if (!r.ok) throw new Error('作品目录请求失败');
              return r.json();
            })
            .then(function (items) {
              if (!Array.isArray(items)) throw new Error('作品目录格式无效');
              return items;
            })
            .catch(function (error) {
              cache = null;
              throw error;
            });
        }
        return cache;
      }
      function render(items, hasCatalog) {
        list.textContent = '';
        items.forEach(function (s) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = s.url;
          a.textContent = s.title;
          var small = document.createElement('small');
          var who = (s.authors && s.authors.length ? s.authors.join(' / ') : '');
          small.textContent = [who, s.chapters + ' 话'].filter(Boolean).join(' · ');
          li.appendChild(a);
          li.appendChild(small);
          list.appendChild(li);
        });
        status.textContent = items.length ? '' : hasCatalog ? '没有匹配的作品' : '当前还没有作品，内容发布后即可检索。';
      }
      function filter(q) {
        var request = ++sequence;
        var kw = String(q || '').trim().toLowerCase();
        status.textContent = '正在加载作品目录……';
        load().then(function (items) {
          if (request !== sequence) return;
          if (!kw) return render(items, items.length > 0);
          render(items.filter(function (s) {
            var hay = [s.title, s.description].concat(s.authors || [], s.artists || [], s.tags || []).join(' ').toLowerCase();
            return hay.indexOf(kw) !== -1;
          }), items.length > 0);
        }).catch(function () {
          if (request !== sequence) return;
          list.textContent = '';
          status.textContent = '作品目录加载失败，请点击“过滤”重试。';
        });
      }
      form.addEventListener('submit', function (e) { e.preventDefault(); filter(input.value); });
      input.addEventListener('input', function () { filter(input.value); });
      filter('');
    })();
  </script>
</Base>

<style>
  .meta-head { margin-bottom: 1.2rem; }
  #meta-form, #search-form { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.8rem 0 0.7rem; }
  #meta-q, #search-input, #search-series {
    flex: 1;
    min-width: 12rem;
    padding: 0.62rem 1rem;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  #meta-q::placeholder, #search-input::placeholder { color: var(--text-dim); }
  #meta-q:focus, #search-input:focus, #search-series:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 3px var(--focus-ring); }
  #search-series { flex: 0 1 auto; min-width: 8rem; }
  #search-more { margin-top: 1rem; }
  #search-more[hidden] { display: none; }
  #meta-status, #search-status { margin: 0.2rem 0 0.8rem; }
  .note { font-size: 14px; line-height: 1.65; margin: 0; }
  #search-results { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  #search-results:empty { display: none; }
  #search-results li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    padding: 0.8rem 1rem;
    background: var(--surface-raised);
    border: 0;
    border-radius: 8px;
    box-shadow: none;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }
  #search-results li:hover { transform: translateY(-1px); border-color: var(--accent-soft); box-shadow: none; }
  #search-results li a { color: var(--ink); font-weight: 500; }
  #search-results li a:hover { color: var(--accent-strong); }
  #search-results li small { color: var(--text-dim); font-size: 12px; }
</style>
